{
  "schema": "kyuubiki.dependency-audit-lockfiles/v2",
  "npm": [
    "apps/frontend",
    "apps/hub-gui",
    "apps/installer-gui",
    "apps/workbench-gui"
  ],
  "cargo": [
    "workers/rust",
    "sdks/rust",
    "apps/hub-gui/src-tauri",
    "apps/installer-gui/src-tauri",
    "apps/workbench-gui/src-tauri"
  ],
  "hex": [
    "apps/web"
  ],
  "hex_denied_packages": [
    "cowboy",
    "cowboy_telemetry",
    "cowlib",
    "plug_cowboy",
    "ranch"
  ],
  "hex_advisory_mitigations": [],
  "hex_osv": {
    "endpoint": "https://api.osv.dev/v1/querybatch",
    "ecosystem": "Hex",
    "query_repositories": ["hexpm"],
    "cache_path": "tmp/dependency-audit/hex-osv-cache.json",
    "cache_max_age_seconds": 86400,
    "timeout_seconds": 20
  }
}
