  "qualification_requirements": [
    {
      "id": "sdk-native-result-local-contract",
      "module_id": "sdk-operator", "paradigm": "validation", "dimension": "contract",
      "scope": "macos-arm64+linux-x86_64/source-sdk/exact-result-identity-and-success-envelope",
      "target": "verified", "claims": ["native-result-identity-source-regression"],
      "basis": ["docs/operator-store-integration.html", "docs/operator-sdk.md"],
      "acceptance": "Retain the November 13 real red-to-green registry, direct JSON adapter and ABI export/decode regressions. Reject wrong, blank or padded result identities and success envelopes carrying an error; never relabel a result. This proves attribution, not numerical correctness or arbitrary direct handler calls."
    },
    {
      "id": "agent-native-result-local-recovery",
      "module_id": "runtime-agent-cli", "paradigm": "validation", "dimension": "execution",
      "scope": "macos-arm64+linux-x86_64/source-agent/native-result-rejection-and-healthy-next-task",
      "target": "verified", "claims": ["native-result-identity-source-regression"],
      "basis": ["docs/operator-store-integration.html"],
      "acceptance": "Retain actual source-built Agents rejecting wrong/empty IDs and contradictory success with original task identity, non-retryable failure, child exit and a separate healthy follow-up. Earlier valid template execution alone does not verify bad-result rejection; no current installed App claim follows."
    },
    {
      "id": "agent-unix-owned-process-local-recovery",
      "module_id": "runtime-agent-cli", "paradigm": "validation", "dimension": "recovery",
      "scope": "macos-arm64+linux-x86_64/source-agent/per-call-owned-process-group-faults",
      "target": "verified", "claims": ["native-unix-owned-process-source-regression"],
      "basis": ["docs/operator-store-integration.html"],
      "acceptance": "Retain source-native crash, constructor hang, deadline, cancellation, parent SIGKILL and owned-descendant cleanup with healthy next tasks. The group is established before plugin loading. Escaped process groups, hostile native code, host power loss, simultaneous watchdog failure and Windows are outside this bounded verification."
    },
    {
      "id": "agent-bounded-pending-cancellation-local-recovery",
      "module_id": "runtime-agent-cli", "paradigm": "validation", "dimension": "recovery",
      "scope": "macos-arm64+linux-x86_64/source-agent/local-tls/bounded-legacy-pending-cancel",
      "target": "verified", "claims": ["agent-bounded-pending-cancellation-source-regression"],
      "basis": ["docs/operator-store-integration.html"],
      "acceptance": "Retain bounded 1024-entry/256-byte pending cancellation, duplicate idempotency, no eviction, atomic one-shot consumption and active/exact cancellation at capacity. Source Agents use local TLS to reject excess IDs, preserve intents across rejected execution admission, consume all retained IDs and run healthy follow-ups. Unit tests prove registration rejection skips package cleanup and cleanup failure does not undo accepted cancellation. Restart explicitly loses these process-local intents; this does not verify durable cancellation, installed GUI/SDK, hostile-client availability, or retention of real job-scoped packages over TLS."
    },
    {
      "id": "agent-package-cleanup-contention-local-recovery",
      "module_id": "runtime-agent-cli", "paradigm": "validation", "dimension": "recovery",
      "scope": "macos-arm64+linux-x86_64/source-agent/loopback/stalled-fetch-cleanup-lock-admission",
      "target": "verified", "claims": ["agent-package-cleanup-contention-source-regression"],
      "basis": ["docs/operator-store-integration.html"],
      "acceptance": "Keep cancellation registration independent of package lifecycle lock admission. A stalled HTTP resolution must not delay cancellation acknowledgment; explicit cleanup returns a typed busy error without mutation, capacity stays occupied until execution exits, then cleanup-only retry and a healthy same-job solve succeed. Unit tests reject poisoned locks and invalid identities. This is not a total fetch/filesystem deadline, actual bound-package retention, TLS contention, installed GUI/SDK, power-loss or Windows qualification."
    },
    {
      "id": "agent-supervised-package-fetch-local-recovery",
      "module_id": "runtime-agent-cli", "paradigm": "validation", "dimension": "recovery",
      "scope": "macos-arm64+linux-x86_64/source-agent/loopback/supervised-download-cancel-and-deadline",
      "target": "verified", "claims": ["agent-supervised-package-fetch-source-regression"],
      "basis": ["docs/operator-store-integration.html"],
      "acceptance": "Terminate and reap a stalled download before terminal failure; verify socket closure, unpublished-generation cleanup including an injected incomplete file, no automatic retry and healthy same-job execution. Exercise header stalls, partial resolution bodies and total timeout without cancellation; unit-test cancellable/bounded lifecycle waiting. This does not qualify HTTPS faults, large real artifact writes, parent loss during download, power loss, installed GUI/SDK, Windows or a hard filesystem deadline."
    },
    {
      "id": "agent-large-download-restart-local-recovery",
      "module_id": "runtime-agent-cli", "paradigm": "validation", "dimension": "recovery",
      "scope": "macos-arm64+linux-x86_64/source-agent/loopback/64mib-download-16mib-prefix-cancel-truncate-sigkill-restart",
      "target": "verified", "claims": ["agent-large-download-restart-source-regression"],
      "basis": ["docs/operator-store-integration.html"],
      "acceptance": "Observe real 16 MiB partial files from a declared 64 MiB entrypoint before cancellation, HTTP truncation and owned-Agent SIGKILL. Require downloader exit, no publication/replay, startup stale-session removal, and explicit re-fetch/execute of a real template. Separately verify a complete 64 MiB synthetic artifact through Installer without executing it. This does not qualify physical power loss, all orphan/restart races, parallel janitors, HTTPS faults, Windows, installed GUI/SDK or whole-process memory bounds."
    },
    {
      "id": "agent-orphan-download-coordination-local-recovery",
      "module_id": "runtime-agent-cli", "paradigm": "validation", "dimension": "recovery",
      "scope": "macos-arm64+linux-x86_64/source-agent/local-filesystem/suspended-orphan-and-concurrent-session-cleanup",
      "target": "verified", "claims": ["agent-orphan-download-coordination-source-regression"],
      "basis": ["docs/operator-store-integration.html"],
      "acceptance": "Hold a real downloader stopped across owned-Agent SIGKILL and replacement startup; retain its partial file while the independent child lease survives. After child exit, explicit generation preparation reaps the deferred session and executes a real template without harming live peers. Four independently started Agents must claim one stale cleanup exactly once and execute separately. Bound catalog lock waiting, retain the stable lock inode and prevent late child admission from recreating deleted sessions. Not all schedules, mixed binaries, NFS, Windows, power loss or installed GUI/SDK qualification."
    },
    {
      "id": "agent-session-initialization-local-recovery",
      "module_id": "runtime-agent-cli", "paradigm": "validation", "dimension": "recovery",
      "scope": "macos-arm64+linux-x86_64/source-session-initializer/local-filesystem/owned-child-sigkill-and-prefix-recovery",
      "target": "verified", "claims": ["agent-session-initialization-source-regression"],
      "basis": ["docs/operator-store-integration.html"],
      "acceptance": "Kill owned native test children running production session initialization at ten committed-intent creation boundaries and two cleanup boundaries. Recover matching incomplete metadata non-recursively, retain live leases, foreign or nonempty contents and symlinks. A torn intent must create no session and remain reported; unknown old partial sessions stay untouched. Require idempotent cleanup and independent proof revocation. These test-build barriers do not qualify full Agent startup at every boundary, physical power loss, mixed binaries, network filesystems, Windows, installed GUI/SDK or adversarial concurrent filesystem mutation."
    },
