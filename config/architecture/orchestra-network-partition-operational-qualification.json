{
  "$schema": "../../schemas/orchestra-network-partition-operational-qualification-contract.schema.json",
  "schema_version": "kyuubiki.orchestra-network-partition-operational-qualification-contract/v1",
  "qualification_id": "two-orchestra-postgresql-network-partition-fencing-operational",
  "target_coordinate": {
    "module_id": "orchestra-control-plane",
    "paradigm": "runtime_api",
    "target_grade": "operational"
  },
  "capture": {
    "orchestra_host_role": "local-orchestra-qualification-host",
