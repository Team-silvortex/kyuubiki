{
  "schema_version": "kyuubiki.usability-release-gate/v1",
  "baseline_release": "moxi 2.15.x",
  "target_release": "daji 3.0.0",
  "policy": {
    "all_blocking_journeys_must_pass": true,
    "planned_or_static_only_is_not_release_evidence": true,
    "production_runtime_must_be_native": true,
    "gate_scope": "development_contract_and_ui_invocation",
    "release_claim_allowed": false,
    "closed_release_subtiers": [
      "packaged_desktop_round_trip/macos-installed",
      "fault_injection_and_recovery/workflow-branch-isolation",
      "fault_injection_and_recovery/agent-watchdog-state-machine",
      "fault_injection_and_recovery/agent-watchdog-stale-timeout",
      "fault_injection_and_recovery/orchestra-agent-process-loss",
      "fault_injection_and_recovery/installer-journal-replay",
      "remote_agent_orchestra_round_trip/installer-managed-linux",
      "upgrade_and_rollback/agent-remote-linux",
      "upgrade_and_rollback/runtime-payload-remote-linux"
    ],
    "unclosed_release_tiers": [
      "packaged_desktop_round_trip",
      "fault_injection_and_recovery",
      "remote_agent_orchestra_round_trip",
      "upgrade_and_rollback"
    ]
  },
  "capability_contract": "config/architecture/desktop-capability-closure.json",
  "source_guards": [
    {
      "id": "native-production-runtime",
      "paths": [
        "workers/rust/crates/script-runner/src/main.rs",
        "scripts/kyuubiki.cmd"
      ],
      "forbidden_tokens": ["kyuubiki-runtime.mjs"]
    },
    {
      "id": "native-integration-and-remote-runtime",
      "paths": [
        "tests/integration/workbench-ui-smoke.shared.mjs",
        "tests/integration/direct-mesh-gui-smoke.test.mjs",
        "tests/integration/orchestrator-agent-api-smoke/support.mjs",
        "tests/integration/distributed-control-plane-smoke.test.mjs",
        "tests/integration/workflow-branch-diagnostics-smoke.test.mjs",
        "tests/integration/workflow-complex-smoke.test.mjs",
        "tests/integration/workflow-distributed-smoke.test.mjs",
        "tests/integration/workflow-offline-mesh-smoke.test.mjs",
        "tests/integration/workflow-offline-mesh-branch-diagnostics-smoke.test.mjs",
        "workers/rust/crates/script-runner/src/workflow_mesh_remote.rs"
      ],
      "forbidden_tokens": ["kyuubiki-runtime.mjs"]
    }
  ],
  "journeys": [
    {
      "id": "install-repair",
      "title": "Install, inspect, and repair a local deployment",
      "blocking": true,
      "capabilities": [
        "installer.workspace.bootstrap",
        "installer.environment.init",
        "installer.integrity.inspect",
        "installer.integrity.repair",
        "installer.runtime.install-payload"
      ],
      "probes": [
        ["check-install-update-disk-hygiene"],
        ["check-component-integrity-protocol"],
        [
          "check-installer-recovery-fault-injection",
          "--out",
          "tmp/usability-installer-recovery-fault-injection.json"
        ]
      ]
    },
    {
      "id": "create-open-project",
      "title": "Create, validate, and open a project bundle",
      "blocking": true,
      "capabilities": [
        "hub.project.create",
        "hub.project.inspect",
        "hub.project.validate",
        "hub.project.open-workbench"
      ],
      "probes": [
        [
          "check-desktop-usability-journeys",
          "--journey",
          "create-open-project",
          "--execute"
        ],
        [
          "desktop-packaged-smoke",
          "--verify-report",
          "releases/usability-evidence/2.15.0/macos-installed-desktop-smoke.json"
        ],
        ["check-gui-runtime-capability-contract"],
        ["check-ui-automation-contract"]
      ]
    },
    {
      "id": "compose-workflow",
      "title": "Compose and validate a workflow with cross-operator datasets",
      "blocking": true,
      "capabilities": [
        "workbench.analysis.open-local"
      ],
      "probes": [
        ["check-workflow-dataset-contract"],
        ["check-desktop-usability-journeys", "--journey", "compose-workflow"],
        ["check-ui-automation-contract"],
        [
          "build-material-research-bundle",
          "--study",
          "heat-spreader",
          "--out",
          "tmp/usability-material-research-bundle.json"
        ]
      ]
    },
    {
      "id": "execute-observe",
      "title": "Execute a TaskIR workload and observe its outcome",
      "blocking": true,
      "capabilities": [
        "hub.runtime.start-local",
        "workbench.runtime.start-local",
        "workbench.runtime.inspect"
      ],
      "probes": [
        ["check-desktop-usability-journeys", "--journey", "execute-observe"],
        ["check-operator-task-ir-contract"],
        [
          "check-installed-runtime-operational-qualification",
          "--verify-report",
          "releases/usability-evidence/2.14.6/installed-runtime-operational-qualification.json"
        ],
        [
          "check-operator-validation",
          "--execute",
          "--profile",
          "line-field-closed-form",
          "--out",
          "tmp/usability-line-field-validation.json"
        ]
      ]
    },
    {
      "id": "diagnose-recover",
      "title": "Diagnose a failed path and recover without cascading failure",
      "blocking": true,
      "capabilities": [
        "hub.environment.validate",
        "installer.integrity.inspect",
        "installer.integrity.repair",
        "workbench.runtime.inspect"
      ],
      "probes": [
        ["check-desktop-usability-journeys", "--journey", "diagnose-recover"],
        [
          "check-runtime-recovery-fault-injection",
          "--out",
          "tmp/usability-runtime-recovery-fault-injection.json"
        ],
        [
          "check-orchestra-recovery-fault-injection",
          "--out",
          "tmp/usability-orchestra-recovery-fault-injection.json"
        ],
        [
          "check-installer-recovery-fault-injection",
          "--out",
          "tmp/usability-installer-recovery-fault-injection.json"
        ],
        ["check-gui-runtime-capability-contract"],
        ["check-component-integrity-protocol"]
      ]
    },
    {
      "id": "retain-export",
      "title": "Retain and validate reproducible research evidence",
      "blocking": true,
      "capabilities": [
        "hub.project.inspect",
        "hub.project.validate"
      ],
      "probes": [
        [
          "build-material-research-bundle",
          "--study",
          "heat-spreader",
          "--out",
          "tmp/usability-material-research-bundle.json"
        ],
        [
          "check-material-research-bundle",
          "--in",
          "tmp/usability-material-research-bundle.json"
        ],
        ["check-material-exploration-chain-contract"]
      ]
    },
    {
      "id": "localize-layout",
      "title": "Use supported languages and stable desktop interaction layouts",
      "blocking": true,
      "capabilities": [
        "hub.project.open-workbench",
        "workbench.analysis.open-local"
      ],
      "probes": [
        ["validate-language-packs"],
        ["check-desktop-usability-journeys", "--journey", "localize-layout"],
        ["check-ui-automation-contract"],
        [
          "check-desktop-ui-validation",
          "--verify-report",
          "releases/usability-evidence/2.15.0/desktop-ui-validation-qualification.json"
        ]
      ]
    },
    {
      "id": "update-cleanly",
      "title": "Download and apply updates without unmanaged residue",
      "blocking": true,
      "capabilities": [
        "installer.update.download",
        "installer.update.apply",
        "installer.integrity.inspect"
      ],
      "probes": [
        ["check-install-update-disk-hygiene"],
        ["check-component-integrity-protocol"],
        [
          "check-agent-update-operational-qualification",
          "--verify-report",
          "releases/usability-evidence/2.14.3/agent-update-operational-qualification.json"
        ],
        [
          "check-runtime-payload-operational-qualification",
          "--verify-report",
          "releases/usability-evidence/2.14.3/runtime-payload-operational-qualification.json"
        ]
      ]
    }
  ]
}
