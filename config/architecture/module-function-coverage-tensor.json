  "evidence_grade_policy": {
    "gate_mode": "advisory",
    "weakest_limit": 24,
    "levels": [
      {
        "id": "unassessed",
        "score": 0,
        "description": "No machine-readable evidence is attached to the coordinate."
      },
      {
        "id": "declared",
        "score": 20,
        "description": "The matrix or a contract declares the capability, without proving a runnable path."
      },
      {
        "id": "exercised",
        "score": 40,
        "description": "At least one mapped command exercises the path, but proof depth is not explicitly asserted."
      },
      {
        "id": "verified",
        "score": 60,
        "description": "Assertions, boundaries, invariants, or reference outputs verify the claimed behavior."
      },
      {
        "id": "qualified",
        "score": 80,
        "description": "Repeatable convergence, fault, scale, cross-language, or cross-platform evidence qualifies the path."
      },
      {
        "id": "operational",
        "score": 100,
        "description": "Retained packaged, installed, multi-host, or recovery evidence proves an operational journey."
      }
    ],
    "targets": {
      "product_surface": "verified",
      "runtime_api": "verified",
      "solver_execution": "qualified",
      "workflow_composition": "qualified",
      "validation": "qualified",
      "benchmark": "qualified",
      "security": "qualified",
      "persistence_provenance": "verified",
      "deployment_update": "qualified",
      "sdk_headless": "qualified"
    },
    "priority_weights": {
