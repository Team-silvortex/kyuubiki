    "tests::solver_execution_capability::solver_execution_capability_does_not_admit_operator_task_programs",
    "tests::spring_control_rpc::serializes_agent_descriptor_round_trip",
    "tests::spring_control_rpc::serializes_progress_frames",
    "tests::spring_control_rpc::builds_error_responses",
    "tests::workflow_dataset_contract::workflow_dataset_data_classes_match_schema_enum",
    "tests::workflows::serializes_workflow_graph_run_request_round_trip"
