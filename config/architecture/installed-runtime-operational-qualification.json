{
  "$schema": "../../schemas/installed-runtime-operational-qualification-contract.schema.json",
  "schema_version": "kyuubiki.installed-runtime-operational-qualification-contract/v1",
  "qualification_id": "remote-linux-installer-managed-runtime-operational",
  "capture": {
    "solve_report": "tmp/installed-runtime-operational-prototype/solve.json",
    "restart_fetch_report": "tmp/installed-runtime-operational-prototype/fetch-report.json",
    "detached_fetch_report": "tmp/installed-runtime-operational-prototype/detached-fetch-report.json",
    "detached_status": "tmp/installed-runtime-operational-prototype/detached-status.txt",
    "cleanup_report": "tmp/installed-runtime-operational-prototype/cleanup.json",
    "installed_digests": "tmp/installed-runtime-operational-prototype/installed-digests.txt",
    "execution_host_role": "remote-linux-qualification-host",
    "platform": "linux",
    "architecture": "x86_64",
    "package_version": "2.7.0",
    "workflow_id": "qualification.installed-runtime.bar",
    "minimum_agent_count": 2,
    "restart_count": 2
  },
  "source_guard": {
    "files": [
      "scripts/kyuubiki",
      "workers/rust/crates/script-runner/src/main.rs",
      "workers/rust/crates/desktop-runtime/src/runtime_control.rs",
      "workers/rust/crates/desktop-runtime/src/runtime_layout.rs",
      "workers/rust/crates/desktop-runtime/src/runtime_options.rs",
      "workers/rust/crates/installer/src/release.rs"
    ],
    "required_text": [
      "KYUUBIKI_REPO_ROOT",
      "KYUUBIKI_RUNTIME_FRONTEND_DISABLED",
      "startup rollback",
      "installer-managed",
      "[\"start\"]"
    ]
  },
  "retention": {
    "report_schema": "kyuubiki.installed-runtime-operational-qualification/v1",
    "report_schema_path": "schemas/installed-runtime-operational-qualification-report.schema.json",
    "report_path": "releases/usability-evidence/2.14.6/installed-runtime-operational-qualification.json",
    "forbidden_content": [
      "/home/",
      "/users/",
      "192.168.",
      "127.0.0.1",
      "kyuubiki-lab",
      "username",
      "credential"
    ]
  },
  "required_checks": [
    "installed_payload_activated",
    "source_tree_detached",
    "native_runtime_managed",
    "frontend_omitted",
    "headless_service_execution",
    "agent_dispatch_observed",
    "numerical_result_verified",
    "orchestra_restart_completed",
    "result_retained_after_restart",
    "detached_restart_completed",
    "cleanup_complete",
    "retention_sanitized"
  ]
}
