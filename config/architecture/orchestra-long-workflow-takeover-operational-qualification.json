    "report_schema_path": "schemas/orchestra-long-workflow-takeover-operational-qualification-report.schema.json",
    "report_path": "releases/usability-evidence/2.18.3/orchestra-long-workflow-takeover-operational-qualification.json",
    "forbidden_content": [
      "hostname",
      "host_address",
      "job_id",
      "credential",
      "authorization: bearer",
      "192.168.",
      "/Users/",
      "/home/",
      "kyuubiki-dev"
    ]
  },
  "source_guard": {
    "files": [
      "apps/web/lib/kyuubiki_web/orchestra/workflow_recovery_coordinator.ex",
      "apps/web/lib/kyuubiki_web/orchestra/workflow_recovery_envelope.ex",
      "apps/web/lib/kyuubiki_web/orchestra/workflow_recovery_ownership.ex",
