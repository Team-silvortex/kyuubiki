{
  "$schema": "../../schemas/persistence-provenance-qualification-contract.schema.json",
  "schema_version": "kyuubiki.persistence-provenance-qualification-contract/v1",
  "report_schema": "kyuubiki.persistence-provenance-qualification-report/v1",
  "rounds": 2,
  "required_modules": [
    "installer-shell",
    "workbench-shell",
    "orchestra-control-plane",
    "runtime-engine-solver",
    "runtime-installer",
    "sdk-headless"
  ],
  "suites": [
    {
      "id": "desktop-shell-audit-chain",
      "modules": ["installer-shell", "workbench-shell"],
      "program": "cargo",
      "cwd": "workers/rust",
      "args": [
        "test",
        "-p",
        "kyuubiki-desktop-runtime",
        "audit_log::tests::",
        "--no-fail-fast",
        "--",
        "--nocapture"
      ],
      "source_files": [
        "workers/rust/crates/desktop-runtime/src/audit_log.rs",
        "apps/installer-gui/src-tauri/src/main.rs",
        "apps/workbench-gui/src-tauri/src/main.rs"
      ],
      "required_source_text": [
        "kyuubiki.desktop-audit-record/v1",
        "desktop audit ledger digest mismatch",
        "legacy desktop audit migration rejected",
        "guarded installer action blocked by invalid provenance ledger",
        "installer action completed but provenance persistence failed",
        "kyuubiki.workbench-guarded-mutation-provenance/v1",
        "guarded Workbench action blocked by invalid provenance ledger",
        "Workbench action completed but provenance persistence failed"
      ],
      "assertions": [
        {
          "id": "audit-chain-reloads",
          "label": "append_and_reload_preserve_hash_chain",
          "outcome": "acceptance",
          "boundary": "hash-chain append and reload"
        },
        {
          "id": "audit-chain-rejects-tamper",
          "label": "tampered_record_is_rejected_before_append",
          "outcome": "rejection",
          "boundary": "tampered desktop audit record"
        },
        {
          "id": "audit-path-rejects-escape",
          "label": "ledger_file_names_cannot_escape_the_preferences_sandbox",
          "outcome": "rejection",
          "boundary": "desktop audit path escape"
        },
        {
          "id": "audit-legacy-migrates-cleanly",
          "label": "legacy_json_lines_migrate_without_residue",
          "outcome": "acceptance",
          "boundary": "legacy plain JSON audit migration"
        }
      ]
    },
    {
      "id": "installer-shell-ui-closure",
      "modules": ["installer-shell"],
      "program": "node",
      "cwd": ".",
      "args": [
        "--test",
        "tests/integration/desktop-gui-call-chain-contract.test.mjs"
      ],
      "source_files": [
        "apps/installer-gui/ui/app.js",
        "apps/installer-gui/ui/update-panel.js",
        "apps/installer-gui/src-tauri/capabilities/main.json",
        "apps/installer-gui/src-tauri/permissions/installer.toml"
      ],
      "required_source_text": [
        "refresh-installer-provenance",
        "installer_provenance_status",
        "allow-installer-provenance-status",
        "Mutation provenance ledger"
      ],
      "assertions": [
        {
          "id": "installer-provenance-ipc-closure",
          "label": "Installer closes every direct UI-to-Tauri IPC chain",
          "outcome": "acceptance",
          "boundary": "read-only provenance UI to native command"
        },
        {
          "id": "installer-provenance-action-owner",
          "label": "Installer routes every declarative action and guarded mutation",
          "outcome": "acceptance",
          "boundary": "declarative provenance action ownership"
        }
      ]
    },
    {
      "id": "workbench-shell-provenance-closure",
      "modules": ["workbench-shell"],
      "program": "node",
      "cwd": ".",
      "args": ["--test", "apps/workbench-gui/test/smoke.test.mjs"],
      "source_files": [
        "apps/workbench-gui/src-tauri/src/main.rs",
        "apps/workbench-gui/src-tauri/capabilities/main.json",
        "apps/workbench-gui/src-tauri/permissions/workbench.toml",
        "apps/workbench-gui/test/smoke.test.mjs"
      ],
      "required_source_text": [
        "kyuubiki.workbench-guarded-mutation-provenance/v1",
        "prepare_desktop_provenance_ledger",
        "append_workbench_guarded_mutation_audit",
        "allow-guarded-mutation-action",
        "guarded Workbench mutations use the verified desktop provenance ledger"
      ],
      "assertions": [
        {
          "id": "workbench-provenance-command-capability",
          "label": "desktop shell defines a least-privilege main-window capability",
          "outcome": "acceptance",
          "boundary": "Workbench guarded mutation capability ownership"
        },
        {
          "id": "workbench-provenance-ledger-closure",
          "label": "guarded Workbench mutations use the verified desktop provenance ledger",
          "outcome": "acceptance",
          "boundary": "Workbench guarded mutation ledger closure"
        }
      ]
    },
    {
      "id": "orchestra-persistence-recovery",
      "modules": ["orchestra-control-plane"],
      "program": "mix",
      "cwd": "apps/web",
      "args": [
        "test",
        "--trace",
        "test/kyuubiki_web/storage/persistence_test.exs",
        "test/kyuubiki_web/jobs/store_test.exs",
        "test/kyuubiki_web/orchestra/workflow_recovery_envelope_test.exs",
        "test/kyuubiki_web/orchestra/workflow_restart_recovery_test.exs"
      ],
      "source_files": [
        "apps/web/lib/kyuubiki_web/storage/persistence.ex",
        "apps/web/lib/kyuubiki_web/orchestra/workflow_job_runner.ex",
        "apps/web/lib/kyuubiki_web/orchestra/workflow_recovery_coordinator.ex",
        "apps/web/lib/kyuubiki_web/orchestra/workflow_recovery_envelope.ex",
        "apps/web/test/kyuubiki_web/storage/persistence_test.exs",
        "apps/web/test/kyuubiki_web/jobs/store_test.exs",
        "apps/web/test/kyuubiki_web/orchestra/workflow_recovery_envelope_test.exs",
        "apps/web/test/kyuubiki_web/orchestra/workflow_restart_recovery_test.exs",
        "schemas/workflow-recovery.schema.json"
      ],
      "required_source_text": [
        "kyuubiki.persistence-envelope/v1",
        "kyuubiki.persistence-recovery-receipt/v1",
        "recovered_previous_generation",
        "quarantined_and_defaulted",
        "kyuubiki.workflow-recovery/v1",
        "kyuubiki.workflow-execution-envelope/v1",
        "replays an idempotent in-flight workflow after the Orchestra application restarts",
        "blocks an in-flight side-effect workflow after restart without a checkpoint",
        "blocks a digest-tampered execution envelope before restart replay",
        "reclaims an idempotent workflow after its supervised runner is lost",
        "fails submission when the workflow runner supervisor is unavailable"
      ],
      "assertions": [
        {
          "id": "orchestra-envelope-reloads",
          "label": "writes and reloads a digest-verified persistence envelope",
          "outcome": "acceptance",
          "boundary": "verified local persistence envelope"
        },
        {
          "id": "orchestra-restart-retains-state",
          "label": "reloads persisted jobs and results after store restart",
          "outcome": "acceptance",
          "boundary": "Orchestra process restart"
        },
        {
          "id": "orchestra-recovers-previous",
          "label": "recovers the previous verified generation after tamper",
          "outcome": "rejection",
          "boundary": "tampered primary persistence generation"
        },
        {
          "id": "orchestra-recovers-missing-primary",
          "label": "recovers when a commit loses the primary generation",
          "outcome": "rejection",
          "boundary": "power loss between persistence generation renames"
        },
        {
          "id": "orchestra-quarantines-unrecoverable",
          "label": "quarantines an unrecoverable tampered generation without cascading failure",
          "outcome": "rejection",
          "boundary": "tampered persistence without valid backup"
        },
        {
          "id": "orchestra-workflow-replays-after-restart",
          "label": "replays an idempotent in-flight workflow after the Orchestra application restarts",
          "outcome": "acceptance",
          "boundary": "persisted in-flight workflow application restart"
        },
        {
          "id": "orchestra-workflow-blocks-side-effect-replay",
          "label": "blocks an in-flight side-effect workflow after restart without a checkpoint",
          "outcome": "rejection",
          "boundary": "uncheckpointed side-effect workflow restart"
        },
        {
          "id": "orchestra-workflow-rejects-envelope-tamper",
          "label": "blocks a digest-tampered execution envelope before restart replay",
          "outcome": "rejection",
          "boundary": "tampered workflow execution envelope"
        },
        {
          "id": "orchestra-workflow-reclaims-runner-loss",
          "label": "reclaims an idempotent workflow after its supervised runner is lost",
          "outcome": "acceptance",
          "boundary": "supervised workflow runner loss"
        },
        {
          "id": "orchestra-workflow-rejects-missing-supervisor",
          "label": "fails submission when the workflow runner supervisor is unavailable",
          "outcome": "rejection",
          "boundary": "workflow runner supervisor unavailable"
        }
      ]
    },
    {
      "id": "runtime-installer-journal-recovery",
      "modules": ["runtime-installer"],
      "program": "cargo",
      "cwd": "workers/rust",
      "args": [
        "test",
        "-p",
        "kyuubiki-installer",
        "remote_deployment_replay",
        "--no-fail-fast",
        "--",
        "--nocapture"
      ],
      "source_files": [
        "workers/rust/crates/installer/src/remote_deployment_journal.rs",
        "workers/rust/crates/installer/src/remote_deployment_journal_store.rs",
        "workers/rust/crates/installer/src/remote_deployment_replay.rs",
        "workers/rust/crates/installer/src/tests/remote_deployment_replay.rs"
      ],
      "required_source_text": [
        "kyuubiki.remote-deployment-journal/v2",
        "write_remote_deployment_journal_atomic",
        "prepare_remote_deployment_resume",
        "power_loss_sidecar_recovered"
      ],
      "assertions": [
        {
          "id": "installer-journal-reloads",
          "label": "journal_state_machine_tracks_attempts_and_revision",
          "outcome": "acceptance",
          "boundary": "deployment journal state transition"
        },
        {
          "id": "installer-journal-resumes",
          "label": "replay_marks_running_step_interrupted_without_replaying_completed_prefix",
          "outcome": "acceptance",
          "boundary": "interrupted deployment resume"
        },
        {
          "id": "installer-journal-rejects-tamper",
          "label": "journal_rejects_out_of_order_and_semantically_tampered_steps",
          "outcome": "rejection",
          "boundary": "re-signed deployment path mutation"
        },
        {
          "id": "installer-journal-recovers-atomic-commit",
          "label": "native_fault_injection_recovers_partial_commit_and_rejects_tamper",
          "outcome": "rejection",
          "boundary": "partial commit and digest tamper"
        }
      ]
    },
    {
      "id": "engine-solver-result-provenance",
      "modules": ["runtime-engine-solver"],
      "program": "cargo",
      "cwd": "workers/rust",
      "args": [
        "test",
        "-p",
        "kyuubiki-engine",
        "solver_result_provenance",
        "--no-fail-fast",
        "--",
        "--nocapture"
      ],
      "source_files": [
        "workers/rust/crates/engine/src/workflow_solve_executor.rs",
        "workers/rust/crates/engine/src/tests/core.rs",
        "workers/rust/crates/protocol/src/operator_task_ir.rs"
      ],
      "required_source_text": [
        "kyuubiki.engine-solver-provenance/v1",
        "canonical_json_sha256",
        "result_digest",
        "verify_solver_result_provenance",
        "solver result provenance digest mismatch"
      ],
      "assertions": [
        {
          "id": "engine-provenance-verifies-bound-result",
          "label": "solver_result_provenance_verifies_digest_bound_result",
          "outcome": "acceptance",
          "boundary": "digest-bound Engine solver result"
        },
        {
          "id": "engine-provenance-rejects-result-tamper",
          "label": "solver_result_provenance_rejects_result_tamper",
          "outcome": "rejection",
          "boundary": "Engine solver result content tamper"
        },
        {
          "id": "engine-provenance-rejects-identity-tamper",
          "label": "solver_result_provenance_rejects_identity_tamper",
          "outcome": "rejection",
          "boundary": "Engine solver provenance identity tamper"
        }
      ]
    },
    {
      "id": "headless-operator-task-provenance",
      "modules": ["sdk-headless"],
      "program": "cargo",
      "cwd": "workers/rust",
      "args": [
        "test",
        "-p",
        "kyuubiki-headless-sdk",
        "headless_operator_task_provenance",
        "--no-fail-fast",
        "--",
        "--nocapture"
      ],
      "source_files": [
        "workers/rust/crates/headless-sdk/src/operator_task.rs",
        "workers/rust/crates/headless-sdk/src/operator_task_provenance.rs",
        "workers/rust/crates/headless-sdk/src/operator_task_tests.rs",
        "workers/rust/crates/protocol/src/operator_task_ir.rs"
      ],
      "required_source_text": [
        "kyuubiki.headless-operator-task-provenance/v1",
        "verify_operator_task_provenance_profile",
        "operator_task_provenance_invalid",
        "operator task provenance profile does not match verified lineage",
        "operator task provenance summary and execution preview disagree"
      ],
      "assertions": [
        {
          "id": "headless-provenance-verifies-bound-profile",
          "label": "headless_operator_task_provenance_verifies_bound_profile",
          "outcome": "acceptance",
          "boundary": "Headless digest-bound operator task profile"
        },
        {
          "id": "headless-provenance-rejects-profile-tamper",
          "label": "headless_operator_task_provenance_rejects_profile_tamper",
          "outcome": "rejection",
          "boundary": "Headless operator task provenance profile tamper"
        },
        {
          "id": "headless-provenance-rejects-lineage-mismatch",
          "label": "headless_operator_task_provenance_rejects_summary_preview_mismatch",
          "outcome": "rejection",
          "boundary": "Headless operator task summary preview mismatch"
        }
      ]
    }
  ]
}
