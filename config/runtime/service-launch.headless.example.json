{
  "schema_version": "kyuubiki.service-launch/v1",
  "profile": "headless",
  "services": [
    {
      "id": "agent",
      "command": "bin/kyuubiki-cli",
      "args": ["agent", "--host", "127.0.0.1", "--port", "{port}"],
      "cwd": "."
    },
    {
      "id": "orchestrator",
      "command": "services/orchestrator/bin/kyuubiki_web",
      "args": ["start"],
      "cwd": "services/orchestrator"
    }
  ]
}
