KYUUBIKI_DEPLOYMENT_MODE=local
KYUUBIKI_AGENT_DISCOVERY=static
KYUUBIKI_AGENT_MANIFEST_PATH=./deploy/agents.local.example.json
KYUUBIKI_STORAGE_BACKEND=sqlite
SQLITE_DATABASE_PATH=./tmp/data/kyuubiki_dev.sqlite3
# DATABASE_URL=ecto://seis@127.0.0.1:5432/kyuubiki_dev
# KYUUBIKI_API_TOKEN=change-me
# KYUUBIKI_CLUSTER_API_TOKEN=change-me-cluster
# KYUUBIKI_CLUSTER_ALLOWED_AGENT_IDS=agent-a,agent-b
# KYUUBIKI_CLUSTER_ALLOWED_CLUSTER_IDS=lan-mesh-a
# KYUUBIKI_CLUSTER_REQUIRE_FINGERPRINT=false
# KYUUBIKI_CLUSTER_TIMESTAMP_WINDOW_MS=30000
# KYUUBIKI_PROTECT_READS=false
# KYUUBIKI_DIRECT_MESH_ENABLED=true
# KYUUBIKI_DIRECT_MESH_TOKEN=change-me
KYUUBIKI_AGENT_ENDPOINTS=127.0.0.1:5001,127.0.0.1:5002
# Development source runtimes default to debug agents. Use release for large-mesh qualification.
# KYUUBIKI_AGENT_BUILD_PROFILE=release
# KYUUBIKI_MODEL_ARTIFACT_MAX_BYTES=536870912
# KYUUBIKI_RESULT_ARTIFACT_MAX_BYTES=2147483648
# KYUUBIKI_ARTIFACT_TEMP_RETENTION_SECONDS=3600
# KYUUBIKI_WATCHDOG_STALE_JOB_MS=30000
# KYUUBIKI_AGENT_QUEUE_TIMEOUT_MS=1800000
# KYUUBIKI_ARTIFACT_EXECUTION_TIMEOUT_MS=1800000
# KYUUBIKI_WATCHDOG_QUEUE_TIMEOUT_MS=1800000
# KYUUBIKI_WATCHDOG_JOB_TIMEOUT_MS=1800000
