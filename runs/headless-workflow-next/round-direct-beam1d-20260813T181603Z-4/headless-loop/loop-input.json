{
  "schema_version": "kyuubiki.headless-workflow/v1",
  "exported_at": "1970-01-01T00:00:00.000Z",
  "language": "en",
  "workflow": {
    "id": "template.direct_beam_1d",
    "steps": [
      {
        "action": "solve_beam_1d",
        "payload": {
          "model": {
            "elements": [
              {
                "distributed_load_y": 0.0,
                "id": "b0",
                "moment_of_inertia": 8e-6,
                "node_i": 0,
                "node_j": 1,
                "section_modulus": 0.00016,
                "youngs_modulus": 210000000000.0
              }
            ],
            "nodes": [
              {
                "fix_rz": true,
                "fix_y": true,
                "id": "n0",
                "load_y": 0.0,
                "moment_z": 0.0,
                "x": 0.0
              },
              {
                "fix_rz": false,
                "fix_y": false,
                "id": "n1",
                "load_y": -1000.0,
                "moment_z": 0.0,
                "x": 2.0
              }
            ]
          }
        }
      },
      {
        "action": "job_wait",
        "payload": {
          "interval_ms": 1000,
          "job_id": "{{steps.1.result.job_id}}",
          "timeout_ms": 60000
        }
      },
      {
        "action": "result_fetch",
        "payload": {
          "job_id": "{{steps.1.result.job_id}}"
        }
      }
    ]
  },
  "template": {
    "id": "direct_beam_1d",
    "title": "Direct Beam 1D",
    "description": "Submit a beam 1D structural solve directly and fetch the final result.",
    "runtime_style": "service_only",
    "category": "mechanical",
    "tags": [
      "direct",
      "mechanical",
      "beam",
      "1d"
    ]
  }
}