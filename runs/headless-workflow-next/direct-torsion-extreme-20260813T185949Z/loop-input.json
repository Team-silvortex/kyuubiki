{
  "schema_version": "kyuubiki.headless-workflow/v1",
  "exported_at": "1970-01-01T00:00:00.000Z",
  "language": "en",
  "workflow": {
    "id": "template.direct_torsion_1d",
    "steps": [
      {
        "action": "solve_torsion_1d",
        "payload": {
          "model": {
            "elements": [
              {
                "id": "te0",
                "node_i": 0,
                "node_j": 1,
                "polar_moment": 5e-6,
                "section_modulus": 0.00016,
                "shear_modulus": 80000000000.0
              }
            ],
            "nodes": [
              {
                "fix_rz": true,
                "id": "t0",
                "torque_z": 0.0,
                "x": 0.0
              },
              {
                "fix_rz": false,
                "id": "t1",
                "torque_z": 500.0,
                "x": 1.0
              }
            ]
          }
        }
      },
      {
        "action": "job_wait",
        "payload": {
          "interval_ms": 1000,
          "job_id": "{{steps.1.result.job_id}}",
          "timeout_ms": 60000
        }
      },
      {
        "action": "result_fetch",
        "payload": {
          "job_id": "{{steps.1.result.job_id}}"
        }
      }
    ]
  },
  "template": {
    "id": "direct_torsion_1d",
    "title": "Direct Torsion 1D",
    "description": "Submit a torsion 1D structural solve directly and fetch the final result.",
    "runtime_style": "service_only",
    "category": "mechanical",
    "tags": [
      "direct",
      "mechanical",
      "torsion",
      "1d"
    ]
  }
}