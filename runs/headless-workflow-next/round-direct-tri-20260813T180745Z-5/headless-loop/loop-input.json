{
  "schema_version": "kyuubiki.headless-workflow/v1",
  "exported_at": "1970-01-01T00:00:00.000Z",
  "language": "en",
  "workflow": {
    "id": "template.direct_electrostatic_triangle",
    "steps": [
      {
        "action": "solve_electrostatic_plane_triangle_2d",
        "payload": {
          "model": {
            "elements": [
              {
                "id": "et0",
                "node_i": 0,
                "node_j": 1,
                "node_k": 2,
                "permittivity": 2.5,
                "thickness": 0.01
              }
            ],
            "nodes": [
              {
                "charge_density": 0.0,
                "fix_potential": true,
                "id": "n0",
                "potential": 10.0,
                "x": 0.0,
                "y": 0.0
              },
              {
                "charge_density": 0.0,
                "fix_potential": true,
                "id": "n1",
                "potential": 0.0,
                "x": 1.0,
                "y": 0.0
              },
              {
                "charge_density": 0.0,
                "fix_potential": true,
                "id": "n2",
                "potential": 0.0,
                "x": 0.0,
                "y": 1.0
              }
            ]
          }
        }
      },
      {
        "action": "job_wait",
        "payload": {
          "interval_ms": 1000,
          "job_id": "{{steps.1.result.job_id}}",
          "timeout_ms": 60000
        }
      },
      {
        "action": "result_fetch",
        "payload": {
          "job_id": "{{steps.1.result.job_id}}"
        }
      }
    ]
  },
  "template": {
    "id": "direct_electrostatic_triangle",
    "title": "Direct Electrostatic Triangle",
    "description": "Submit an electrostatic plane triangle solve directly and fetch the final result.",
    "runtime_style": "service_only",
    "category": "electromagnetic",
    "tags": [
      "direct",
      "electrostatic",
      "triangle"
    ]
  }
}