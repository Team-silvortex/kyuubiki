{
  "schema_version": "kyuubiki.headless-workflow/v1",
  "exported_at": "1970-01-01T00:00:00.000Z",
  "language": "en",
  "workflow": {
    "id": "template.direct_frame_3d",
    "steps": [
      {
        "action": "solve_frame_3d",
        "payload": {
          "model": {
            "elements": [
              {
                "area": 0.02,
                "id": "f0",
                "moment_of_inertia_y": 8e-6,
                "moment_of_inertia_z": 8e-6,
                "node_i": 0,
                "node_j": 1,
                "section_modulus_y": 0.00016,
                "section_modulus_z": 0.00016,
                "shear_modulus": 80000000000.0,
                "torsion_constant": 5e-6,
                "youngs_modulus": 210000000000.0
              }
            ],
            "nodes": [
              {
                "fix_rx": true,
                "fix_ry": true,
                "fix_rz": true,
                "fix_x": true,
                "fix_y": true,
                "fix_z": true,
                "id": "n0",
                "load_x": 0.0,
                "load_y": 0.0,
                "load_z": 0.0,
                "moment_x": 0.0,
                "moment_y": 0.0,
                "moment_z": 0.0,
                "x": 0.0,
                "y": 0.0,
                "z": 0.0
              },
              {
                "fix_rx": false,
                "fix_ry": false,
                "fix_rz": false,
                "fix_x": false,
                "fix_y": false,
                "fix_z": false,
                "id": "n1",
                "load_x": 0.0,
                "load_y": -1000.0,
                "load_z": 0.0,
                "moment_x": 0.0,
                "moment_y": 0.0,
                "moment_z": 0.0,
                "x": 2.0,
                "y": 0.0,
                "z": 0.0
              }
            ]
          }
        }
      },
      {
        "action": "job_wait",
        "payload": {
          "interval_ms": 1000,
          "job_id": "{{steps.1.result.job_id}}",
          "timeout_ms": 60000
        }
      },
      {
        "action": "result_fetch",
        "payload": {
          "job_id": "{{steps.1.result.job_id}}"
        }
      }
    ]
  },
  "template": {
    "id": "direct_frame_3d",
    "title": "Direct Frame 3D",
    "description": "Submit a frame 3D structural solve directly and fetch the final result.",
    "runtime_style": "service_only",
    "category": "mechanical",
    "tags": [
      "direct",
      "mechanical",
      "frame",
      "3d"
    ]
  }
}