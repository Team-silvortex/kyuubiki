        "path": "sdks/elixir/lib/kyuubiki_sdk/model_research_execution.ex",
        "approval_path": "sdks/elixir/lib/kyuubiki_sdk/model_plan_approval.ex",
        "frontier_path": "sdks/elixir/lib/kyuubiki_sdk/model_research_frontier.ex",
        "validation_path": "sdks/elixir/lib/kyuubiki_sdk/model_research_validation.ex",
        "executor": "ModelResearchExecution.execute/4",
        "dispatcher": "ModelResearchExecution.session_dispatcher/2",
        "approval_verifier": "caller-owned two-argument function",
        "plan_digest": "ModelPlanApproval.compute_digest/1",
        "approval_request": "ModelPlanApproval.build_request/1",
        "frontier_start": "ModelResearchFrontier.start/2",
        "frontier_advance": "ModelResearchFrontier.advance/4",
        "frontier_digest": "ModelResearchFrontier.compute_digest/1",
        "frontier_validator": "ModelResearchFrontier.validate/1",
        "frontier_digest_verifier": "ModelResearchFrontier.digest_verifier/1",
