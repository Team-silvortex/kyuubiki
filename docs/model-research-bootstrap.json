{
  "$schema": "../schemas/model-research-bootstrap.schema.json",
  "schema_version": "kyuubiki.model-research-bootstrap/v1",
  "entrypoint": "llms.txt",
  "version_line": "daji 3.0.x",
  "purpose": "Give a large model one bounded, machine-readable route from documentation ingestion to a reproducible screening research artifact.",
  "required_documents": [
    {
      "path": "docs/model-research-onboarding.html",
      "role": "Human and WebView-readable research startup sequence."
    },
    {
      "path": "docs/model-collaboration-sdk.md",
      "role": "Provider adapters, policy, redaction, proposal, and confirmation boundary."
    },
    {
      "path": "docs/headless-sdks.md",
      "role": "Backend discovery, execution, observation, and recovery surfaces."
    },
    {
      "path": "docs/automated-material-research-example.md",
      "role": "Reference research loop, retained evidence, limitations, and quality gates."
    },
    {
      "path": "docs/accuracy-baselines.md",
      "role": "Numerical baseline and independent-validation posture."
    },
    {
      "path": "docs/security.md",
      "role": "Trust boundaries, credentials, untrusted inputs, and safe failure rules."
    }
  ],
  "sdk_surfaces": {
    "rust": {
      "path": "sdks/rust/src/model_collaboration.rs",
      "request": "build_model_collaboration_request",
      "normalize": "normalize_model_response",
      "plan": "build_model_headless_plan"
    },
    "python": {
      "path": "sdks/python/kyuubiki_sdk/model_collaboration.py",
      "request": "build_model_collaboration_request",
      "normalize": "normalize_model_response",
      "plan": "build_model_headless_plan"
    },
    "elixir": {
      "path": "sdks/elixir/lib/kyuubiki_sdk/model_collaboration.ex",
      "request": "build_request/3",
      "normalize": "normalize_response/3",
      "plan": "build_plan/2"
    }
  },
  "execution_contract": {
    "approval_request_schema": "schemas/model-plan-approval-request.schema.json",
    "approval_request_fixture": "schemas/examples.model-plan-approval-request.json",
    "approval_schema": "schemas/model-plan-approval.schema.json",
    "approval_fixture": "schemas/examples.model-plan-approval.json",
    "receipt_schema": "schemas/model-research-execution-receipt.schema.json",
    "frontier_schema": "schemas/model-research-frontier.schema.json",
    "frontier_fixture": "schemas/examples.model-research-frontier.json",
    "validation_report_schema": "schemas/model-research-validation-report.schema.json",
    "validation_report_fixture": "schemas/examples.model-research-validation-report.json",
    "approval_authority": "caller_only",
    "surfaces": {
      "rust": {
        "path": "sdks/rust/src/model_research_execution.rs",
        "approval_path": "sdks/rust/src/model_plan_approval.rs",
        "frontier_path": "sdks/rust/src/model_research_frontier.rs",
        "validation_path": "sdks/rust/src/model_research_validation.rs",
        "executor": "execute_model_headless_plan",
        "dispatcher": "SessionModelActionDispatcher",
        "approval_verifier": "ModelApprovalVerifier",
        "plan_digest": "compute_model_headless_plan_digest",
        "approval_request": "build_model_plan_approval_request",
        "frontier_start": "start_model_research_frontier",
        "frontier_advance": "advance_model_research_frontier",
        "frontier_digest": "compute_model_research_frontier_digest",
        "frontier_validator": "validate_model_research_frontier",
        "frontier_digest_verifier": "ModelFrontierDigestVerifier",
        "result_validator": "validate_model_research_frontier_result",
        "receipt_verifier": "ModelReceiptVerifier",
        "frontier_verifier": "ModelFrontierVerifier"
      },
      "python": {
        "path": "sdks/python/kyuubiki_sdk/model_research_execution.py",
        "approval_path": "sdks/python/kyuubiki_sdk/model_plan_approval.py",
        "frontier_path": "sdks/python/kyuubiki_sdk/model_research_frontier.py",
        "validation_path": "sdks/python/kyuubiki_sdk/model_research_validation.py",
        "executor": "execute_model_headless_plan",
        "dispatcher": "SessionModelActionDispatcher",
        "approval_verifier": "ApprovalVerifier",
        "plan_digest": "compute_model_headless_plan_digest",
        "approval_request": "build_model_plan_approval_request",
        "frontier_start": "start_model_research_frontier",
        "frontier_advance": "advance_model_research_frontier",
        "frontier_digest": "compute_model_research_frontier_digest",
        "frontier_validator": "validate_model_research_frontier",
        "frontier_digest_verifier": "ModelFrontierDigestVerifier",
        "result_validator": "validate_model_research_frontier_result",
        "receipt_verifier": "ReceiptVerifier",
