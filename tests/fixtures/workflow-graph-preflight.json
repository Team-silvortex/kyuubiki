{
  "request": {
    "graph": {
      "schema_version": "kyuubiki.workflow-graph/v1",
      "id": "preflight.v1",
      "name": "Preflight contract",
      "version": "1",
      "entry_nodes": ["input"],
      "output_nodes": ["output"],
      "nodes": [
        {"id": "input", "kind": "input", "inputs": [], "outputs": [{"id": "payload", "artifact_type": "artifact/json"}]},
        {"id": "pick", "kind": "transform", "operator_id": "transform.first_available", "config": {"on_error": "skip"}, "inputs": [{"id": "payload", "artifact_type": "artifact/json"}], "outputs": [{"id": "payload", "artifact_type": "artifact/json"}]},
        {"id": "output", "kind": "output", "inputs": [{"id": "payload", "artifact_type": "artifact/json"}], "outputs": []}
      ],
      "edges": [
        {"id": "in.pick", "from": {"node": "input", "port": "payload"}, "to": {"node": "pick", "port": "payload"}, "artifact_type": "artifact/json"},
        {"id": "pick.out", "from": {"node": "pick", "port": "payload"}, "to": {"node": "output", "port": "payload"}, "artifact_type": "artifact/json"}
      ]
    },
    "input_artifacts": {"input": {"value": 42}}
  },
  "cases": [
    {"id": "valid", "accept": true, "changes": []},
    {"id": "missing-input-is-execution-policy", "accept": true, "changes": [{"path": ["input_artifacts"], "value": {}}]},
    {"id": "empty-entry-and-output-lists", "accept": true, "changes": [{"path": ["graph", "entry_nodes"], "value": []}, {"path": ["graph", "output_nodes"], "value": []}]},
    {"id": "same-port-name-in-both-directions", "accept": true, "changes": []},
    {"id": "unknown-advisory-label", "accept": true, "changes": [{"path": ["graph", "nodes", 0, "operator_id"], "value": "custom.input.v1"}]},
    {"id": "disconnected-output", "accept": true, "changes": [{"op": "append", "path": ["graph", "nodes"], "value": {"id": "standalone", "kind": "output", "inputs": [], "outputs": []}}]},
    {"id": "parallel-ports", "accept": true, "changes": [{"op": "append", "path": ["graph", "nodes", 2, "inputs"], "value": {"id": "second", "artifact_type": "artifact/json"}}, {"op": "append", "path": ["graph", "edges"], "value": {"id": "second", "from": {"node": "pick", "port": "payload"}, "to": {"node": "output", "port": "second"}, "artifact_type": "artifact/json"}}]},
    {"id": "wrong-schema", "accept": false, "error": "schema_version", "changes": [{"path": ["graph", "schema_version"], "value": "kyuubiki.workflow-graph/v2"}]},
    {"id": "empty-graph-id", "accept": false, "error": "id", "changes": [{"path": ["graph", "id"], "value": ""}]},
    {"id": "path-graph-id", "accept": false, "error": "id", "changes": [{"path": ["graph", "id"], "value": "../graph"}]},
    {"id": "null-nodes", "accept": false, "error": "nodes", "changes": [{"path": ["graph", "nodes"], "value": null}]},
    {"id": "object-nodes", "accept": false, "error": "nodes", "changes": [{"path": ["graph", "nodes"], "value": {}}]},
    {"id": "empty-nodes", "accept": false, "error": "node", "changes": [{"path": ["graph", "nodes"], "value": []}]},
    {"id": "null-node", "accept": false, "error": "node", "changes": [{"path": ["graph", "nodes", 1], "value": null}]},
    {"id": "duplicate-node", "accept": false, "error": "duplicate", "changes": [{"path": ["graph", "nodes", 1, "id"], "value": "input"}]},
    {"id": "dotted-node", "accept": false, "error": "id", "changes": [{"path": ["graph", "nodes", 1, "id"], "value": "input.payload"}]},
    {"id": "unicode-node", "accept": false, "error": "id", "changes": [{"path": ["graph", "nodes", 1, "id"], "value": "\u00e9"}]},
    {"id": "unknown-kind", "accept": false, "error": "kind", "changes": [{"path": ["graph", "nodes", 1, "kind"], "value": "arbitrary"}]},
    {"id": "null-operator", "accept": false, "error": "operator_id", "changes": [{"path": ["graph", "nodes", 1, "operator_id"], "value": null}]},
    {"id": "invalid-operator", "accept": false, "error": "operator_id", "changes": [{"path": ["graph", "nodes", 1, "operator_id"], "value": "../execute"}]},
    {"id": "null-input-ports", "accept": false, "error": "inputs", "changes": [{"path": ["graph", "nodes", 1, "inputs"], "value": null}]},
    {"id": "object-output-ports", "accept": false, "error": "outputs", "changes": [{"path": ["graph", "nodes", 1, "outputs"], "value": {}}]},
    {"id": "null-port", "accept": false, "error": "port", "changes": [{"path": ["graph", "nodes", 1, "inputs", 0], "value": null}]},
    {"id": "dotted-port", "accept": false, "error": "id", "changes": [{"path": ["graph", "nodes", 1, "inputs", 0, "id"], "value": "payload.field"}]},
    {"id": "duplicate-input-port", "accept": false, "error": "duplicate", "changes": [{"op": "append", "path": ["graph", "nodes", 1, "inputs"], "value": {"id": "payload", "artifact_type": "artifact/json"}}]},
    {"id": "duplicate-output-port", "accept": false, "error": "duplicate", "changes": [{"op": "append", "path": ["graph", "nodes", 1, "outputs"], "value": {"id": "payload", "artifact_type": "artifact/json"}}]},
    {"id": "empty-artifact-type", "accept": false, "error": "artifact_type", "changes": [{"path": ["graph", "nodes", 1, "inputs", 0, "artifact_type"], "value": ""}]},
    {"id": "invalid-artifact-type", "accept": false, "error": "artifact_type", "changes": [{"path": ["graph", "nodes", 1, "inputs", 0, "artifact_type"], "value": "artifact json"}]},
    {"id": "null-edges", "accept": false, "error": "edges", "changes": [{"path": ["graph", "edges"], "value": null}]},
    {"id": "null-edge", "accept": false, "error": "edge", "changes": [{"path": ["graph", "edges", 0], "value": null}]},
    {"id": "duplicate-edge", "accept": false, "error": "duplicate", "changes": [{"path": ["graph", "edges", 1, "id"], "value": "in.pick"}]},
    {"id": "null-endpoint", "accept": false, "error": "source", "changes": [{"path": ["graph", "edges", 0, "from"], "value": null}]},
    {"id": "missing-source-node", "accept": false, "error": "source", "changes": [{"path": ["graph", "edges", 0, "from", "node"], "value": "missing"}]},
    {"id": "missing-source-port", "accept": false, "error": "source", "changes": [{"path": ["graph", "edges", 0, "from", "port"], "value": "missing"}]},
    {"id": "missing-target-node", "accept": false, "error": "target", "changes": [{"path": ["graph", "edges", 0, "to", "node"], "value": "missing"}]},
    {"id": "missing-target-port", "accept": false, "error": "target", "changes": [{"path": ["graph", "edges", 0, "to", "port"], "value": "missing"}]},
    {"id": "source-type-mismatch", "accept": false, "error": "source", "changes": [{"path": ["graph", "nodes", 0, "outputs", 0, "artifact_type"], "value": "artifact/other"}]},
    {"id": "target-type-mismatch", "accept": false, "error": "target", "changes": [{"path": ["graph", "nodes", 1, "inputs", 0, "artifact_type"], "value": "artifact/other"}]},
    {"id": "duplicate-incoming-port", "accept": false, "error": "duplicate incoming", "changes": [{"op": "append", "path": ["graph", "edges"], "value": {"id": "duplicate", "from": {"node": "input", "port": "payload"}, "to": {"node": "pick", "port": "payload"}, "artifact_type": "artifact/json"}}]},
    {"id": "self-cycle", "accept": false, "error": "cycle", "changes": [{"path": ["graph", "edges", 0, "from", "node"], "value": "pick"}]},
    {"id": "two-node-cycle", "accept": false, "error": "cycle", "changes": [{"op": "append", "path": ["graph", "nodes", 2, "outputs"], "value": {"id": "payload", "artifact_type": "artifact/json"}}, {"path": ["graph", "edges", 0, "from", "node"], "value": "output"}]},
    {"id": "disconnected-cycle", "accept": false, "error": "cycle", "changes": [{"op": "append", "path": ["graph", "nodes"], "value": {"id": "isolated", "kind": "transform", "operator_id": "transform.first_available", "inputs": [{"id": "p", "artifact_type": "artifact/json"}], "outputs": [{"id": "p", "artifact_type": "artifact/json"}]}}, {"op": "append", "path": ["graph", "edges"], "value": {"id": "isolated", "from": {"node": "isolated", "port": "p"}, "to": {"node": "isolated", "port": "p"}, "artifact_type": "artifact/json"}}]},
    {"id": "null-entries", "accept": false, "error": "entry_nodes", "changes": [{"path": ["graph", "entry_nodes"], "value": null}]},
    {"id": "missing-entry", "accept": false, "error": "entry", "changes": [{"path": ["graph", "entry_nodes"], "value": ["missing"]}]},
    {"id": "wrong-entry-kind", "accept": false, "error": "input node", "changes": [{"path": ["graph", "entry_nodes"], "value": ["pick"]}]},
    {"id": "wrong-output-kind", "accept": false, "error": "output node", "changes": [{"path": ["graph", "output_nodes"], "value": ["pick"]}]},
    {"id": "unknown-input-artifact", "accept": false, "error": "input_artifacts", "changes": [{"path": ["input_artifacts", "missing"], "value": {}}]},
    {"id": "non-input-artifact", "accept": false, "error": "input_artifacts", "changes": [{"path": ["input_artifacts", "pick"], "value": {}}]},
    {"id": "invalid-input-artifact-key", "accept": false, "error": "input_artifacts", "changes": [{"path": ["input_artifacts", "input.payload"], "value": {}}]},
    {"id": "nul-config-string", "accept": false, "error": "NUL", "changes": [{"path": ["graph", "nodes", 1, "config", "label"], "value": "bad\u0000text"}]},
    {"id": "nul-artifact-key", "accept": false, "error": "NUL", "changes": [{"path": ["input_artifacts", "input", "bad\u0000key"], "value": 0}]}
  ],
  "budgets": [
    {"id": "config-nodes-at", "path": ["graph", "nodes", 1, "config"], "kind": "array", "size": 19999, "accept": true},
    {"id": "config-nodes-over", "path": ["graph", "nodes", 1, "config"], "kind": "array", "size": 20000, "accept": false},
    {"id": "artifact-nodes-at", "path": ["input_artifacts", "input"], "kind": "array", "size": 499999, "accept": true},
    {"id": "artifact-nodes-over", "path": ["input_artifacts", "input"], "kind": "array", "size": 500000, "accept": false},
    {"id": "config-depth-at", "path": ["graph", "nodes", 1, "config"], "kind": "nested", "size": 64, "accept": true},
    {"id": "config-depth-over", "path": ["graph", "nodes", 1, "config"], "kind": "nested", "size": 65, "accept": false},
    {"id": "artifact-depth-at", "path": ["input_artifacts", "input"], "kind": "nested", "size": 64, "accept": true},
    {"id": "artifact-depth-over", "path": ["input_artifacts", "input"], "kind": "nested", "size": 65, "accept": false},
    {"id": "config-string-at", "path": ["graph", "nodes", 1, "config"], "kind": "string", "size": 1000000, "accept": true},
    {"id": "config-string-over", "path": ["graph", "nodes", 1, "config"], "kind": "string", "size": 1000001, "accept": false},
    {"id": "artifact-string-at", "path": ["input_artifacts", "input"], "kind": "string", "size": 1000000, "accept": true},
    {"id": "artifact-string-over", "path": ["input_artifacts", "input"], "kind": "string", "size": 1000001, "accept": false},
    {"id": "config-key-at", "path": ["graph", "nodes", 1, "config"], "kind": "key", "size": 256, "accept": true},
    {"id": "config-key-over", "path": ["graph", "nodes", 1, "config"], "kind": "key", "size": 257, "accept": false},
    {"id": "artifact-key-at", "path": ["input_artifacts", "input"], "kind": "key", "size": 256, "accept": true},
    {"id": "artifact-key-over", "path": ["input_artifacts", "input"], "kind": "key", "size": 257, "accept": false},
    {"id": "graph-id-at", "path": ["graph", "id"], "kind": "string", "size": 128, "accept": true},
    {"id": "graph-id-over", "path": ["graph", "id"], "kind": "string", "size": 129, "accept": false},
    {"id": "nodes-at", "kind": "nodes", "size": 2048, "accept": true},
    {"id": "nodes-over", "kind": "nodes", "size": 2049, "accept": false},
    {"id": "input-ports-at", "kind": "inputs", "size": 32, "accept": true},
    {"id": "input-ports-over", "kind": "inputs", "size": 33, "accept": false},
    {"id": "output-ports-at", "kind": "outputs", "size": 32, "accept": true},
    {"id": "output-ports-over", "kind": "outputs", "size": 33, "accept": false},
    {"id": "edges-at", "kind": "edges", "size": 4096, "accept": true},
    {"id": "edges-over", "kind": "edges", "size": 4097, "accept": false}
  ]
}
