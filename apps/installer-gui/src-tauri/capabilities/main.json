{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege IPC surface for the Kyuubiki Installer main window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-doctor-report",
    "allow-packaged-boot-ready",
    "allow-installation-integrity-report",
    "allow-regression-gate-report",
    "allow-latest-applied-update-record",
    "allow-latest-downloaded-update-record",
    "allow-latest-staged-update-record",
    "allow-update-source-config",
    "allow-unified-update-plan",
    "allow-unified-update-preview",
    "allow-export-launch",
    "allow-read-env-file",
    "allow-certificate-authority-policy",
    "allow-remote-deploy-policy",
    "allow-remote-node-registry",
    "allow-service-status",
    "allow-runtime-payload-status",
    "allow-installer-provenance-status",
    "allow-get-global-language-preference",
    "allow-set-global-language-preference",
    "allow-read-runtime-log",
    "allow-guarded-mutation-action",
    "allow-start-log-stream",
    "allow-stop-log-stream"
  ]
}
