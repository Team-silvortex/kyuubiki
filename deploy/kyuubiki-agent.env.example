# Shared lab-node defaults for the dedicated Ubuntu machine.
# Copy to deploy/kyuubiki-agent.env on the remote host and adjust as needed.

KYUUBIKI_AGENT_PORT=5001
KYUUBIKI_AGENT_ID=kyuubiki-lab-solver
KYUUBIKI_AGENT_ADVERTISE_HOST=kyuubiki-lab.local

# Native TCP defaults to loopback only, even with a wildcard bind. To permit LAN
# callers, uncomment and replace these documentation-only addresses with the
# exact controller/gateway and Mesh source IPs observed by this Agent.
# KYUUBIKI_AGENT_ALLOWED_PEER_IPS=192.0.2.10,2001:db8::10
# Unset means loopback only. Do not set an empty value, wildcard, hostname or CIDR.
# Apply by explicit restart after draining/reconciling work; this is not TLS or
# peer authentication. NAT/proxies share their observed source-IP permission.

# Optional cluster wiring. Leave blank for offline node testing.
KYUUBIKI_ORCHESTRATOR_URL=
KYUUBIKI_CLUSTER_API_TOKEN=
KYUUBIKI_AGENT_FINGERPRINT=
