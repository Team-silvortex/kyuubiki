# Shared lab-node defaults for the dedicated Ubuntu machine.
# Copy to deploy/kyuubiki-agent.env on the remote host and adjust as needed.

KYUUBIKI_AGENT_PORT=5001
KYUUBIKI_AGENT_ID=kyuubiki-lab-solver
KYUUBIKI_AGENT_ADVERTISE_HOST=kyuubiki-lab.local

# Native TCP defaults to loopback only, even with a wildcard bind. To permit LAN
# callers, uncomment and replace these documentation-only addresses with the
# exact controller/gateway and Mesh source IPs observed by this Agent.
# KYUUBIKI_AGENT_ALLOWED_PEER_IPS=192.0.2.10,2001:db8::10
# Unset means loopback only. Do not set an empty value, wildcard, hostname or CIDR.
# Apply by explicit restart after draining/reconciling work; this is not TLS or
# peer authentication. NAT/proxies share their observed source-IP permission.
# Allowed LAN sources can only ping/describe by default. On an isolated trusted
# LAN, explicitly opt in to unauthenticated task submission, results and recovery:
# KYUUBIKI_AGENT_TRUSTED_LAN_CONTROL=true
# Unset/false keeps discovery only; other values reject startup. This does not
# replace the IP allowlist, enable TLS, or permit remote drain/resume. Restart to
# apply/revoke; preserve original receipts and never blindly replay unknown work.

# Optional cluster wiring. Leave blank for offline node testing.
# Native Agent API mode is opt-in and all-or-nothing. Inject a cryptographically
# random 32..256-character URL-safe token from a secret manager, not this template
# or command-line arguments. Certificate/private-key paths stay deployment-local.
# KYUUBIKI_AGENT_API_TOKEN=<inject at process launch; do not commit>
# KYUUBIKI_AGENT_TLS_CERT_FILE=<owned credential directory>/agent.crt
# KYUUBIKI_AGENT_TLS_KEY_FILE=<owned credential directory>/agent.key
# TLS 1.3, verified CA + certificate DNS/IP SAN, ALPN kyuubiki-agent/1.
# Private key: regular non-symlink file, current owner, Unix permissions 0600.
# IP allowlist and explicit LAN control remain required for remote task execution.
# Rotate by drain/reconcile + restart; existing receipts are not replayed.
# This is NOT KYUUBIKI_CLUSTER_API_TOKEN and does not bind another Orchestra.

KYUUBIKI_ORCHESTRATOR_URL=
KYUUBIKI_CLUSTER_API_TOKEN=
KYUUBIKI_AGENT_FINGERPRINT=
