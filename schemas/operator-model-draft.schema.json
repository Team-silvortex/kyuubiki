{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kyuubiki.dev/operator-model-draft.schema.json",
  "title": "Kyuubiki Operator Model Draft",
  "description": "A non-executable Rust operator design proposal that must pass Operator SDK readiness before implementation and package admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "descriptor",
    "input_json_schema",
    "output_json_schema",
    "implementation"
  ],
  "properties": {
    "schema_version": {
      "const": "kyuubiki.operator-model-draft/v1"
    },
    "descriptor": {
      "$ref": "#/$defs/descriptor"
    },
    "input_json_schema": {
      "$ref": "#/$defs/json_object_schema"
    },
    "output_json_schema": {
      "$ref": "#/$defs/json_object_schema"
    },
    "implementation": {
      "$ref": "#/$defs/implementation"
    }
  },
  "$defs": {
    "schema_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact_type", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "artifact_type": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "dataset_value": { "type": ["string", "null"] },
        "schema_ref": {
          "oneOf": [
            { "$ref": "#/$defs/schema_ref" },
            { "type": "null" }
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_status", "baseline_cases", "smoke_paths"],
      "properties": {
        "baseline_status": {
          "enum": ["verified", "partial", "unverified"]
        },
        "baseline_cases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "smoke_paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "domain",
        "family",
        "kind",
        "summary",
        "capability_tags",
        "origin",
        "input_schema",
        "output_schema",
        "inputs",
        "outputs",
        "validation"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["solver", "transform", "extract", "export", "workflow_bridge"]
        },
        "summary": { "type": "string", "minLength": 1 },
        "capability_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "origin": {
          "enum": ["built_in", "external_local", "external_remote"]
        },
        "input_schema": { "$ref": "#/$defs/schema_ref" },
        "output_schema": { "$ref": "#/$defs/schema_ref" },
        "inputs": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/port" }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/port" }
        },
        "validation": { "$ref": "#/$defs/validation" }
      }
    },
    "json_object_schema": {
      "type": "object",
      "required": ["type", "properties", "additionalProperties"],
      "properties": {
        "type": { "const": "object" },
        "properties": { "type": "object" },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "additionalProperties": { "const": false }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_type",
        "operator_type",
        "handler_trait",
        "algorithm_steps",
        "deterministic",
        "side_effects"
      ],
      "properties": {
        "input_type": { "type": "string", "minLength": 1 },
        "operator_type": { "type": "string", "minLength": 1 },
        "handler_trait": {
          "enum": ["json_operator", "operator_handler"]
        },
        "algorithm_steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1 }
        },
        "deterministic": { "type": "boolean" },
        "side_effects": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
