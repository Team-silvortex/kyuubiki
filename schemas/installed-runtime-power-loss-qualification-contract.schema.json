{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.dev/schemas/installed-runtime-power-loss-qualification-contract.schema.json",
  "title": "Kyuubiki Installed Runtime Power-Loss Qualification Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "qualification_id",
    "reboot_identity",
    "persistent_state",
    "execution",
    "source_guard",
    "retention",
    "required_checks"
  ],
  "properties": {
    "$schema": {
      "const": "../../schemas/installed-runtime-power-loss-qualification-contract.schema.json"
    },
    "schema_version": {
      "const": "kyuubiki.installed-runtime-power-loss-qualification-contract/v1"
    },
    "qualification_id": {
      "const": "physical-linux-installed-runtime-power-loss-recovery"
    },
    "reboot_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boot_id_source",
        "machine_id_source",
        "require_changed_boot_id",
        "require_same_machine"
      ],
      "properties": {
        "boot_id_source": { "const": "/proc/sys/kernel/random/boot_id" },
        "machine_id_source": { "const": "/etc/machine-id" },
        "require_changed_boot_id": { "const": true },
        "require_same_machine": { "const": true }
      }
    },
    "persistent_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_schema",
        "intent_schema_path",
        "write_protocol",
        "cleanup_policy",
        "contains_absolute_paths"
      ],
      "properties": {
        "intent_schema": { "const": "kyuubiki.installed-runtime-power-loss-intent/v1" },
        "intent_schema_path": {
          "const": "schemas/installed-runtime-power-loss-intent.schema.json"
        },
        "write_protocol": { "const": "create-sync-rename-directory-sync" },
        "cleanup_policy": { "const": "validated-session-and-intent-only" },
        "contains_absolute_paths": { "const": false }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_host_role",
        "platform",
        "architecture",
        "package_version",
        "workflow_id",
        "minimum_agent_count",
        "frontend_loaded",
        "source_tree_detached"
      ],
      "properties": {
        "execution_host_role": { "const": "remote-linux-qualification-host" },
        "platform": { "const": "linux" },
        "architecture": { "const": "x86_64" },
        "package_version": { "$ref": "#/$defs/version" },
        "workflow_id": { "const": "qualification.installed-runtime.bar" },
        "minimum_agent_count": { "type": "integer", "minimum": 2 },
        "frontend_loaded": { "const": false },
        "source_tree_detached": { "const": true }
      }
    },
    "source_guard": { "$ref": "#/$defs/source_guard" },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_schema",
        "report_schema_path",
        "report_path",
        "forbidden_content"
      ],
      "properties": {
        "report_schema": { "const": "kyuubiki.installed-runtime-power-loss-qualification/v1" },
        "report_schema_path": {
          "const": "schemas/installed-runtime-power-loss-qualification-report.schema.json"
        },
        "report_path": { "type": "string", "pattern": "^releases/usability-evidence/" },
        "forbidden_content": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "required_checks": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "source_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "required_text"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_text": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
