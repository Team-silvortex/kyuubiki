{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.local/schemas/protocol-validation-qualification-report.schema.json",
  "title": "Kyuubiki Protocol Validation Qualification Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at_unix_ms",
    "contract_path",
    "status",
    "platform",
    "protocol_tests",
    "fuzz_profiles",
    "task_ir",
    "rpc",
    "contract_checks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "kyuubiki.protocol-validation-qualification-report/v1" },
    "generated_at_unix_ms": { "type": "integer", "minimum": 1 },
    "contract_path": { "const": "config/architecture/protocol-validation-qualification.json" },
    "status": { "enum": ["pass", "fail"] },
    "platform": {
      "type": "object",
      "required": ["os", "arch"],
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "protocol_tests": {
      "type": "object",
      "required": ["command", "exit_code", "elapsed_ms", "passed", "failed", "ignored", "measured", "filtered_out", "required_tests", "output_excerpt"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "array", "minItems": 4, "items": { "type": "string" } },
        "exit_code": { "type": ["integer", "null"] },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "ignored": { "type": "integer", "minimum": 0 },
        "measured": { "type": "integer", "minimum": 0 },
        "filtered_out": { "type": "integer", "minimum": 0 },
        "required_tests": {
          "type": "array",
          "items": { "$ref": "#/$defs/check" }
        },
        "output_excerpt": { "type": "string", "minLength": 1 }
      }
    },
    "fuzz_profiles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "cases", "test", "passed"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "cases": { "type": "integer", "minimum": 1 },
          "test": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" }
        }
      }
    },
    "task_ir": {
      "type": "object",
      "required": ["task_count", "verified_digest_count", "execution_summary_count", "tamper_rejection_count", "authoring_modes", "structured_rejection_codes"],
      "additionalProperties": false,
      "properties": {
        "task_count": { "type": "integer", "minimum": 1 },
        "verified_digest_count": { "type": "integer", "minimum": 1 },
        "execution_summary_count": { "type": "integer", "minimum": 1 },
        "tamper_rejection_count": { "type": "integer", "minimum": 1 },
        "authoring_modes": { "type": "array", "items": { "type": "string" } },
        "structured_rejection_codes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "rpc": {
      "type": "object",
      "required": ["advertised_method_count", "round_trip_count", "unique_wire_method_count", "unknown_method_rejected", "boundary_rejection_codes"],
      "additionalProperties": false,
      "properties": {
        "advertised_method_count": { "type": "integer", "minimum": 1 },
        "round_trip_count": { "type": "integer", "minimum": 1 },
        "unique_wire_method_count": { "type": "integer", "minimum": 1 },
        "unknown_method_rejected": { "type": "boolean" },
        "boundary_rejection_codes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contract_checks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["command", "status", "exit_code", "elapsed_ms", "output"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["pass", "fail"] },
          "exit_code": { "type": ["integer", "null"] },
          "elapsed_ms": { "type": "integer", "minimum": 0 },
          "output": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "passed"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" }
      }
    }
  }
}
