{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.local/schemas/system-security-qualification-report.schema.json",
  "title": "Kyuubiki System Security Qualification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_unix_ms",
    "contract_path",
    "status",
    "platform",
    "rounds",
    "checks",
    "modules",
    "lanes",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": "kyuubiki.system-security-qualification-report/v1"
    },
    "generated_at_unix_ms": {
      "type": "integer",
      "minimum": 1
    },
    "contract_path": {
      "const": "config/architecture/system-security-qualification.json"
    },
    "status": {
      "const": "pass"
    },
    "platform": {
      "$ref": "#/$defs/platform"
    },
    "rounds": {
      "type": "integer",
      "minimum": 2,
      "maximum": 4
    },
    "checks": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "modules": {
      "type": "array",
      "minItems": 8,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 7,
      "items": {
        "$ref": "#/$defs/lane"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "arch"],
      "properties": {
        "os": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "arch": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "lane"],
      "properties": {
        "module_id": {
          "$ref": "#/$defs/identifier"
        },
        "lane": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "passed"],
      "properties": {
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "passed": {
          "const": true
        }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round",
        "status",
        "exit_code",
        "elapsed_ms",
        "output_sha256",
        "assertions",
        "output_excerpt"
      ],
      "properties": {
        "round": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "const": "pass"
        },
        "exit_code": {
          "const": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assertion"
          }
        },
        "output_excerpt": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "program",
        "cwd",
        "args",
        "coordinates",
        "rounds",
        "repeatable"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "program": {
          "enum": ["self", "cargo", "mix"]
        },
        "cwd": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/coordinate"
          }
        },
        "rounds": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/round"
          }
        },
        "repeatable": {
          "const": true
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "status", "covered_lanes", "check_ids"],
      "properties": {
        "module_id": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "const": "pass"
        },
        "covered_lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "check_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "status", "covered_modules", "check_ids"],
      "properties": {
        "lane": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "const": "pass"
        },
        "covered_modules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "check_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_count",
        "round_count",
        "passed_round_count",
        "module_count",
        "lane_count",
        "coordinate_count",
        "failed_check_ids"
      ],
      "properties": {
        "check_count": {
          "type": "integer",
          "minimum": 10
        },
        "round_count": {
          "type": "integer",
          "minimum": 20
        },
        "passed_round_count": {
          "type": "integer",
          "minimum": 20
        },
        "module_count": {
          "type": "integer",
          "minimum": 8
        },
        "lane_count": {
          "type": "integer",
          "minimum": 7
        },
        "coordinate_count": {
          "type": "integer",
          "minimum": 20
        },
        "failed_check_ids": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
