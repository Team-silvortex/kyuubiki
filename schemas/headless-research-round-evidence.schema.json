{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kyuubiki.dev/headless-research-round-evidence.schema.json",
  "title": "Kyuubiki Headless Research Round Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "round_id",
    "workflow_id",
    "iteration",
    "qualified",
    "batch_content_sha256",
    "run_report_sha256",
    "run_mode",
    "primary_metric_ids",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "kyuubiki.headless-research-round-evidence/v1"
    },
    "round_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "qualified": {
      "const": true
    },
    "batch_content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "run_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "run_mode": {
      "const": "execute:service"
    },
    "patch_receipt": {
      "$ref": "headless-parameter-patch-receipt.schema.json"
    },
    "previous_round": {
      "$ref": "#/$defs/previous_round"
    },
    "primary_metric_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/metric"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previous_round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "round_id",
        "iteration",
        "evidence_sha256",
        "batch_content_sha256"
      ],
      "properties": {
        "round_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "iteration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "batch_content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "pointer", "unit", "objective", "value"],
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "pointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/steps/(0|[1-9][0-9]*)/result_preview/(result|metrics)/.+$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "objective": {
          "enum": ["minimize", "maximize", "observe"]
        },
        "value": {
          "type": "number"
        }
      }
    }
  }
}
