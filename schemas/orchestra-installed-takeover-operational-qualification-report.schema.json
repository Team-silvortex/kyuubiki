{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kyuubiki.local/orchestra-installed-takeover-operational-qualification-report.schema.json",
  "title": "Kyuubiki Installed Orchestra Takeover Operational Qualification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_unix_ms",
    "status",
    "qualification_id",
    "journey",
    "installation",
    "topology",
    "lease_policy",
    "phases",
    "cleanup",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "kyuubiki.orchestra-installed-takeover-operational-qualification/v1"
    },
    "generated_at_unix_ms": { "type": "integer", "minimum": 1 },
    "status": { "const": "pass" },
    "qualification_id": {
      "const": "installer-managed-two-orchestra-postgresql-crash-takeover-operational"
    },
    "journey": {
      "const": "installed-production-release-two-orchestra-postgresql-sigkill-takeover"
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_version",
        "platform",
        "architecture",
        "runtime_origin",
        "activation_generation",
        "payload_manifest_sha256",
        "service_manifest_sha256",
        "orchestra_executable_sha256",
        "source_tree_detached",
        "source_fallback",
        "immutable_payload_shared"
      ],
      "properties": {
        "package_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "platform": { "const": "linux" },
        "architecture": { "const": "x86_64" },
        "runtime_origin": { "const": "installer-managed" },
        "activation_generation": { "type": "integer", "minimum": 1 },
        "payload_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "service_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "orchestra_executable_sha256": { "$ref": "#/$defs/sha256" },
        "source_tree_detached": { "const": true },
        "source_fallback": { "const": false },
        "immutable_payload_shared": { "const": true }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orchestra_host_role",
        "database_host_role",
        "orchestra_process_count",
        "database",
        "database_ephemeral",
        "database_loopback_only",
        "transport",
        "build_profile",
        "managed_state_per_instance"
      ],
      "properties": {
        "orchestra_host_role": { "const": "remote-linux-qualification-host" },
        "database_host_role": { "const": "remote-linux-qualification-host" },
        "orchestra_process_count": { "type": "integer", "minimum": 2 },
        "database": { "const": "postgresql" },
        "database_ephemeral": { "const": true },
        "database_loopback_only": { "const": true },
        "transport": { "const": "local-loopback" },
        "build_profile": { "const": "production-otp-release" },
        "managed_state_per_instance": { "const": true }
      }
    },
    "lease_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_ttl_ms", "heartbeat_ms", "retry_ms", "failure_mode"],
      "properties": {
        "lease_ttl_ms": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "heartbeat_ms": { "type": "integer", "minimum": 1 },
        "retry_ms": { "type": "integer", "minimum": 1 },
        "failure_mode": { "const": "sigkill" }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_owner",
        "initial_standby",
        "takeover",
        "former_owner_rejoin",
        "takeover_elapsed_ms",
        "primary_endpoint_closed"
      ],
      "properties": {
        "initial_owner": { "$ref": "#/$defs/lease_phase" },
        "initial_standby": { "$ref": "#/$defs/lease_phase" },
        "takeover": { "$ref": "#/$defs/lease_phase" },
        "former_owner_rejoin": { "$ref": "#/$defs/lease_phase" },
        "takeover_elapsed_ms": { "type": "integer", "minimum": 1, "maximum": 30000 },
        "primary_endpoint_closed": { "const": true }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orchestra_processes_stopped",
        "orchestra_ports_closed",
        "remote_database_removed",
        "runtime_store_removed",
        "managed_run_root_removed"
      ],
      "properties": {
        "orchestra_processes_stopped": { "const": true },
        "orchestra_ports_closed": { "const": true },
        "remote_database_removed": { "const": true },
        "runtime_store_removed": { "const": true },
        "managed_run_root_removed": { "const": true }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "const": "pass" }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lease_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_role",
        "lease_status",
        "observed_owner_role",
        "fencing_token"
      ],
      "properties": {
        "process_role": { "enum": ["primary", "standby", "former-owner"] },
        "lease_status": { "enum": ["owner", "standby"] },
        "observed_owner_role": { "enum": ["primary", "standby"] },
        "fencing_token": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
