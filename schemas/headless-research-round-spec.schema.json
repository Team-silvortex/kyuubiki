{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kyuubiki.dev/headless-research-round-spec.schema.json",
  "title": "Kyuubiki Headless Research Round Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "round_id",
    "workflow_id",
    "iteration",
    "primary_metric_ids",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "kyuubiki.headless-research-round-spec/v1"
    },
    "round_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "primary_metric_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/metric"
      }
    }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "pointer", "unit", "objective"],
      "properties": {
        "metric_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "pointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^/steps/(0|[1-9][0-9]*)/result_preview/(result|metrics)/.+$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "objective": {
          "enum": ["minimize", "maximize", "observe"]
        }
      }
    }
  }
}
