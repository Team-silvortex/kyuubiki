{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.local/schemas/distributed-task-recovery-operational-qualification-contract.schema.json",
  "title": "Kyuubiki Distributed Task Recovery Operational Qualification Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "qualification_id",
    "target_coordinate",
    "ownership",
    "capture",
    "retention",
    "source_guard",
    "required_checks",
    "commands"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": {
      "const": "kyuubiki.distributed-task-recovery-operational-qualification-contract/v1"
    },
    "qualification_id": {
      "const": "two-host-distributed-task-recovery-operational"
    },
    "target_coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "paradigm", "target_grade"],
      "properties": {
        "module_id": { "const": "orchestra-control-plane" },
        "paradigm": { "const": "fault_injection_and_recovery" },
        "target_grade": { "const": "operational" }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_plane_owner", "execution_owner", "evidence_owner"],
      "properties": {
        "control_plane_owner": { "const": "orchestra-control-plane" },
        "execution_owner": { "const": "runtime-agent-cli" },
        "evidence_owner": { "const": "verification-evidence" }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_scenarios",
        "orchestrator_platform",
        "primary_agent_platform",
        "fallback_agent_platform",
        "build_profile",
        "remote_restarts_minimum",
        "cleanup_required"
      ],
      "properties": {
        "required_scenarios": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": ["idempotent", "side_effect_blocked", "checkpointed"]
          }
        },
        "orchestrator_platform": { "const": "macos" },
        "primary_agent_platform": { "const": "linux" },
        "fallback_agent_platform": { "const": "macos" },
        "build_profile": { "const": "release" },
        "remote_restarts_minimum": { "type": "integer", "minimum": 3 },
        "cleanup_required": { "const": true }
      }
    },
    "retention": { "$ref": "#/$defs/retention" },
    "source_guard": { "$ref": "#/$defs/sourceGuard" },
    "required_checks": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture", "verify"],
      "properties": {
        "capture": { "type": "string", "minLength": 1 },
        "verify": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_schema", "report_schema_path", "report_path", "forbidden_content"],
      "properties": {
        "report_schema": {
          "const": "kyuubiki.distributed-task-recovery-operational-qualification/v1"
        },
        "report_schema_path": { "$ref": "#/$defs/repoPath" },
        "report_path": { "$ref": "#/$defs/repoPath" },
        "forbidden_content": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "required_text"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repoPath" }
        },
        "required_text": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
