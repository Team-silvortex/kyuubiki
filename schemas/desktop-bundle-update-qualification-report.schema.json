{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.local/schemas/desktop-bundle-update-qualification-report.schema.json",
  "title": "Kyuubiki Packaged Desktop Bundle Update Qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "journey",
    "execution_host_role",
    "platform",
    "runtime_version",
    "first_version",
    "second_version",
    "first_payload",
    "second_payload",
    "rollback_payload",
    "first_activation",
    "second_activation",
    "rollback_activation",
    "active_after_upgrade",
    "active_after_rollback",
    "installed_versions",
    "probes",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "kyuubiki.desktop-bundle-update-qualification/v1"
    },
    "status": { "const": "pass" },
    "journey": {
      "const": "installer-managed-packaged-desktop-set-upgrade-and-rollback"
    },
    "execution_host_role": {
      "pattern": "^(local|remote)-(macos|linux|windows)-qualification-host$"
    },
    "platform": { "enum": ["macos", "linux", "windows"] },
    "runtime_version": { "$ref": "#/$defs/version" },
    "first_version": { "$ref": "#/$defs/version" },
    "second_version": { "$ref": "#/$defs/version" },
    "first_payload": { "$ref": "#/$defs/payload" },
    "second_payload": { "$ref": "#/$defs/payload" },
    "rollback_payload": { "$ref": "#/$defs/payload" },
    "first_activation": { "$ref": "#/$defs/activation" },
    "second_activation": { "$ref": "#/$defs/activation" },
    "rollback_activation": { "$ref": "#/$defs/activation" },
    "active_after_upgrade": { "$ref": "#/$defs/version" },
    "active_after_rollback": { "$ref": "#/$defs/version" },
    "installed_versions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/version" }
    },
    "probes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/probe" }
    },
    "checks": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "payload_sha256", "components"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "payload_sha256": { "$ref": "#/$defs/sha256" },
        "components": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/component" }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_id",
        "content_sha256",
        "entrypoint_sha256",
        "file_count"
      ],
      "properties": {
        "component_id": { "enum": ["hub", "installer", "workbench"] },
        "content_sha256": { "$ref": "#/$defs/sha256" },
        "entrypoint_sha256": { "$ref": "#/$defs/sha256" },
        "file_count": { "type": "integer", "minimum": 1 }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generation",
        "version",
        "previous_version",
        "relative_path",
        "platform",
        "payload_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "kyuubiki.desktop-bundle-activation/v1"
        },
        "generation": { "type": "integer", "minimum": 1, "maximum": 3 },
        "version": { "$ref": "#/$defs/version" },
        "previous_version": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/version" }]
        },
        "relative_path": {
          "type": "string",
          "pattern": "^versions/[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "platform": { "enum": ["macos", "linux", "windows"] },
        "payload_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "package_version",
        "component_id",
        "runtime_version",
        "executable_sha256",
        "pid",
        "success"
      ],
      "properties": {
        "phase": {
          "enum": ["initial-install", "upgraded-install", "rollback"]
        },
        "package_version": { "$ref": "#/$defs/version" },
        "component_id": { "enum": ["hub", "installer", "workbench"] },
        "runtime_version": { "$ref": "#/$defs/version" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "pid": { "type": "integer", "minimum": 1 },
        "success": { "const": true }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ok"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ok": { "const": true }
      }
    }
  }
}
