{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.local/schemas/model-plan-approval.schema.json",
  "title": "Kyuubiki Model Plan Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "approval_id",
    "session_id",
    "workflow_id",
    "plan_digest",
    "authority",
    "issued_at",
    "approved_steps"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/model-plan-approval.schema.json"
    },
    "schema_version": {
      "const": "kyuubiki.model-plan-approval/v2"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Digest of the complete canonical model Headless plan approved by the caller."
    },
    "authority": {
      "type": "string",
      "minLength": 1,
      "description": "Caller-owned approving identity. A model response is not an approval authority."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "action"],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "action": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    }
  }
}
