{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.dev/schemas/test-coverage-posture.schema.json",
  "title": "Kyuubiki Test Coverage Posture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_line",
    "truthfulness_policy",
    "code_surfaces",
    "non_code_coverage_gates"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "kyuubiki.test-coverage-posture/v1"
    },
    "release_line": {
      "type": "string",
      "minLength": 1
    },
    "truthfulness_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code_coverage_claim", "separate_from"],
      "properties": {
        "code_coverage_claim": {
          "const": "not-100-percent-until-artifacts-and-thresholds-exist"
        },
        "separate_from": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      }
    },
    "code_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/codeSurface"
      }
    },
    "non_code_coverage_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonCodeGate"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lines", "branches", "functions"],
      "properties": {
        "lines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "branches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "functions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "codeSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "language",
        "root",
        "test_command",
        "planned_tool",
        "planned_command",
        "planned_artifact",
        "status",
        "minimum_next_threshold"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "$ref": "#/$defs/repoPath"
        },
        "test_command": {
          "type": "string",
          "minLength": 1
        },
        "planned_tool": {
          "type": "string",
          "minLength": 1
        },
        "planned_command": {
          "type": "string",
          "minLength": 1
        },
        "planned_artifact": {
          "$ref": "#/$defs/repoPath"
        },
        "status": {
          "enum": ["declared", "instrumented", "thresholded", "enforced"]
        },
        "minimum_next_threshold": {
          "$ref": "#/$defs/thresholds"
        }
      }
    },
    "nonCodeGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "command"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
