{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.local/schemas/model-research-bootstrap.schema.json",
  "title": "Kyuubiki Model Research Bootstrap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entrypoint",
    "required_documents",
    "sdk_surfaces",
    "execution_contract",
    "preflight",
    "research_protocol",
    "first_research",
    "hard_rules",
    "completion_contract"
  ],
  "properties": {
    "$schema": {
      "const": "../schemas/model-research-bootstrap.schema.json"
    },
    "schema_version": {
      "const": "kyuubiki.model-research-bootstrap/v1"
    },
    "entrypoint": {
      "type": "string",
      "const": "llms.txt"
    },
    "version_line": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 24
    },
    "required_documents": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/document" }
    },
    "sdk_surfaces": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sdkSurface" },
      "required": ["rust", "python", "elixir"]
    },
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_schema",
        "approval_fixture",
        "receipt_schema",
        "frontier_schema",
        "frontier_fixture",
        "validation_report_schema",
        "validation_report_fixture",
        "approval_authority",
        "surfaces"
      ],
      "properties": {
        "approval_schema": { "$ref": "#/$defs/repoPath" },
        "approval_fixture": { "$ref": "#/$defs/repoPath" },
        "receipt_schema": { "$ref": "#/$defs/repoPath" },
        "frontier_schema": { "$ref": "#/$defs/repoPath" },
        "frontier_fixture": { "$ref": "#/$defs/repoPath" },
        "validation_report_schema": { "$ref": "#/$defs/repoPath" },
        "validation_report_fixture": { "$ref": "#/$defs/repoPath" },
        "approval_authority": { "const": "caller_only" },
        "surfaces": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/executionSurface" },
          "required": ["rust", "python", "elixir"]
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_schema", "report_fixture", "execution_authority", "surfaces"],
      "properties": {
        "report_schema": { "$ref": "#/$defs/repoPath" },
        "report_fixture": { "$ref": "#/$defs/repoPath" },
        "execution_authority": { "const": "none_preflight_only" },
        "surfaces": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/preflightSurface" },
          "required": ["rust", "python", "elixir"]
        }
      }
    },
    "research_protocol": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/stage" }
    },
    "first_research": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_fixture",
        "proposal_fixture",
        "catalog_request_fixture",
        "workflow_id",
        "reliability_posture"
      ],
      "properties": {
        "session_fixture": { "$ref": "#/$defs/repoPath" },
        "proposal_fixture": { "$ref": "#/$defs/repoPath" },
        "catalog_request_fixture": { "$ref": "#/$defs/repoPath" },
        "workflow_id": { "type": "string", "minLength": 1 },
        "reliability_posture": {
          "enum": ["screening_only"]
        }
      }
    },
    "hard_rules": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 8 }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 8 }
    },
    "completion_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_artifacts", "required_claims", "forbidden_claims"],
      "properties": {
        "required_artifacts": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "required_claims": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_claims": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "role": { "type": "string", "minLength": 8 }
      }
    },
    "sdkSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "request", "normalize", "plan"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "request": { "type": "string", "minLength": 1 },
        "normalize": { "type": "string", "minLength": 1 },
        "plan": { "type": "string", "minLength": 1 }
      }
    },
    "executionSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "frontier_path",
        "validation_path",
        "executor",
        "dispatcher",
        "approval_verifier",
        "frontier_start",
        "frontier_advance",
        "result_validator",
        "receipt_verifier",
        "frontier_verifier"
      ],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "frontier_path": { "$ref": "#/$defs/repoPath" },
        "validation_path": { "$ref": "#/$defs/repoPath" },
        "executor": { "type": "string", "minLength": 1 },
        "dispatcher": { "type": "string", "minLength": 1 },
        "approval_verifier": { "type": "string", "minLength": 1 },
        "frontier_start": { "type": "string", "minLength": 1 },
        "frontier_advance": { "type": "string", "minLength": 1 },
        "result_validator": { "type": "string", "minLength": 1 },
        "receipt_verifier": { "type": "string", "minLength": 1 },
        "frontier_verifier": { "type": "string", "minLength": 1 }
      }
    },
    "preflightSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "inspect"],
      "properties": {
        "path": { "$ref": "#/$defs/repoPath" },
        "inspect": { "type": "string", "minLength": 1 }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objective", "outputs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "objective": { "type": "string", "minLength": 12 },
        "actions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
