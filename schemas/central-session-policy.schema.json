{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.dev/schemas/central-session-policy.schema.json",
  "title": "Kyuubiki central session policy",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "current_auth",
    "identity_provider",
    "planned_auth",
    "session_rules"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "kyuubiki.central-session-policy/v2" },
    "status": { "type": "string" },
    "current_auth": {
      "type": "object",
      "required": ["mode", "descriptor"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "minLength": 1 },
        "descriptor": { "type": "object" }
      }
    },
    "identity_provider": { "$ref": "#/$defs/identityProvider" },
    "planned_auth": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "status", "intended_clients"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "status": { "type": "string" },
          "intended_clients": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "session_rules": {
      "type": "object",
      "required": [
        "store_download_requires_session",
        "external_store_may_require_session",
        "self_hosted_store_requires_external_identity",
        "publish_requires_session",
        "agent_registration_requires_cluster_identity",
        "credential_storage"
      ],
      "additionalProperties": false,
      "properties": {
        "store_download_requires_session": { "type": "boolean" },
        "external_store_may_require_session": { "type": "boolean" },
        "self_hosted_store_requires_external_identity": { "type": "boolean" },
        "publish_requires_session": { "type": "boolean" },
        "agent_registration_requires_cluster_identity": { "type": "boolean" },
        "credential_storage": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "identityProvider": {
      "type": "object",
      "required": [
        "status",
        "provider_id",
        "protocol",
        "configuration_source",
        "interactive_flow",
        "required_request_checks",
        "allowed_scopes",
        "subject_key",
        "credential_storage",
        "forbidden_flows"
      ],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["unconfigured", "configured", "disabled"] },
        "provider_id": { "type": ["string", "null"] },
        "protocol": { "const": "oidc" },
        "configuration_source": { "const": "deployment_environment" },
        "interactive_flow": { "const": "authorization_code_pkce" },
        "required_request_checks": {
          "type": "array",
          "items": { "enum": ["exact_redirect_uri", "state", "nonce", "pkce_s256"] },
          "minItems": 4,
          "uniqueItems": true
        },
        "allowed_scopes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "contains": { "const": "openid" },
          "uniqueItems": true
        },
        "subject_key": { "const": "issuer_and_subject" },
        "credential_storage": {
          "const": "platform_keychain_server_session_or_memory_only"
        },
        "forbidden_flows": {
          "type": "array",
          "items": { "enum": ["password_grant", "dynamic_client_registration"] },
          "minItems": 2,
          "uniqueItems": true
        }
      }
    }
  }
}
