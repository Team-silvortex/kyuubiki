{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.dev/schemas/kcore-manifest.schema.json",
  "title": "Kyuubiki Core Exchange manifest",
  "description": "Language-neutral manifest for a frozen .kcore simulation or research exchange artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "format",
    "format_version",
    "core_id",
    "title",
    "kind",
    "producer",
    "artifacts",
    "contracts",
    "entrypoints",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "kyuubiki.kcore/v1" },
    "format": { "const": "kcore" },
    "format_version": { "const": 1 },
    "core_id": { "$ref": "#/$defs/token" },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "kind": { "$ref": "#/$defs/token" },
    "producer": { "$ref": "#/$defs/producer" },
    "created_at": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contract" }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "provenance": {},
    "metadata": { "type": "object" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "runtime": { "type": "string" }
      }
    },
    "schemaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version"],
      "properties": {
        "schema": { "$ref": "#/$defs/nonEmptyString" },
        "version": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "media_type",
        "object_path",
        "byte_length",
        "sha256"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "role": { "$ref": "#/$defs/token" },
        "media_type": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "object_path": {
          "type": "string",
          "pattern": "^objects/[a-f0-9]{2}/[a-f0-9]{64}$"
        },
        "byte_length": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "name": { "type": "string", "minLength": 1 },
        "schema_ref": { "$ref": "#/$defs/schemaReference" },
        "encoding": { "type": "string", "minLength": 1 },
        "shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "unit": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schema_version", "artifact_id"],
      "properties": {
        "name": { "$ref": "#/$defs/token" },
        "schema_version": { "$ref": "#/$defs/nonEmptyString" },
        "artifact_id": { "$ref": "#/$defs/token" },
        "purpose": { "type": "string" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "core_digest_sha256"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "core_digest_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
