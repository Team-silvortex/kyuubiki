{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.local/schemas/orchestra-benchmark-qualification-report.schema.json",
  "title": "Kyuubiki Orchestra Benchmark Qualification Report",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at_unix_ms",
    "contract_path",
    "status",
    "platform",
    "source_tree_sha256",
    "rounds",
    "summary",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "kyuubiki.orchestra-benchmark-qualification-report/v1"
    },
    "generated_at_unix_ms": { "type": "integer", "minimum": 1 },
    "contract_path": {
      "const": "config/architecture/orchestra-benchmark-qualification.json"
    },
    "status": { "const": "pass" },
    "platform": {
      "type": "object",
      "required": ["os", "arch"],
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "source_tree_sha256": { "$ref": "#/$defs/digest" },
    "rounds": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/round" }
    },
    "summary": {
      "type": "object",
      "required": [
        "round_count",
        "case_count",
        "largest_pass_through_count",
        "max_observed_elapsed_ms",
        "stable_semantics"
      ],
      "additionalProperties": false,
      "properties": {
        "round_count": { "type": "integer", "minimum": 2 },
        "case_count": { "type": "integer", "minimum": 1 },
        "largest_pass_through_count": { "type": "integer", "minimum": 1 },
        "max_observed_elapsed_ms": { "type": "integer", "minimum": 0 },
        "stable_semantics": { "const": true }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "case": {
      "type": "object",
      "required": [
        "pass_through_count",
        "elapsed_ms",
        "completed_nodes",
        "skipped_nodes",
        "response_mode",
        "loop_passes",
        "total_elapsed_ms",
        "scheduler_overhead_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "pass_through_count": { "type": "integer", "minimum": 1 },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "completed_nodes": { "type": "integer", "minimum": 1 },
        "skipped_nodes": { "const": 0 },
        "response_mode": { "const": "auto-compact" },
        "loop_passes": { "const": 1 },
        "total_elapsed_ms": { "type": "number", "minimum": 0 },
        "scheduler_overhead_ms": { "type": "number", "minimum": 0 }
      }
    },
    "round": {
      "type": "object",
      "required": [
        "round",
        "program",
        "cwd",
        "args",
        "launch_elapsed_ms",
        "raw_report_sha256",
        "semantic_sha256",
        "cases"
      ],
      "additionalProperties": false,
      "properties": {
        "round": { "type": "integer", "minimum": 1 },
        "program": { "const": "mix" },
        "cwd": { "const": "apps/web" },
        "args": {
          "type": "array",
          "minItems": 4,
          "items": { "type": "string", "minLength": 1 }
        },
        "launch_elapsed_ms": { "type": "integer", "minimum": 1 },
        "raw_report_sha256": { "$ref": "#/$defs/digest" },
        "semantic_sha256": { "$ref": "#/$defs/digest" },
        "cases": {
          "type": "array",
          "minItems": 3,
          "items": { "$ref": "#/$defs/case" }
        }
      }
    }
  }
}
