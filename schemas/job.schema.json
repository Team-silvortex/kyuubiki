{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.local/schemas/job.schema.json",
  "title": "Job",
  "description": "Durable FEM job metadata shared between orchestration and workers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "project_id",
    "simulation_case_id",
    "status",
    "progress",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "model_version_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "simulation_case_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "preprocessing",
        "partitioning",
        "solving",
        "postprocessing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "status_detail": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "active",
        "terminal",
        "recoverable",
        "timing"
      ],
      "properties": {
        "lifecycle": {
          "type": "string",
          "enum": [
            "active",
            "terminal"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "terminal": {
          "type": "boolean"
        },
        "failure_class": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "watchdog_stalled",
            "watchdog_timeout",
            "execution_timeout",
            "runtime_failure",
            "operator_cancelled",
            "cancelled",
            null
          ]
        },
        "recoverable": {
          "type": "boolean"
        },
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "queue_wait_ms",
            "execution_elapsed_ms",
            "total_elapsed_ms",
            "queue_timeout_ms",
            "execution_timeout_ms",
            "effective_timeout_ms",
            "job_submission_deadline",
            "execution_started_at",
            "effective_deadline"
          ],
          "properties": {
            "phase": {
              "type": "string",
              "enum": ["queue", "execution"]
            },
            "queue_wait_ms": {
              "type": "integer",
              "minimum": 0
            },
            "execution_elapsed_ms": {
              "type": ["integer", "null"],
              "minimum": 0
            },
            "total_elapsed_ms": {
              "type": "integer",
              "minimum": 0
            },
            "queue_timeout_ms": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "execution_timeout_ms": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "effective_timeout_ms": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "job_submission_deadline": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "execution_started_at": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "effective_deadline": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        }
      }
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "residual": {
      "type": [
        "number",
        "null"
      ]
    },
    "iteration": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "worker_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
