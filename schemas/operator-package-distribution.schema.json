{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.dev/schemas/operator-package-distribution.schema.json",
  "title": "Kyuubiki operator package distribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sdk_api_version", "package_id", "package_version", "artifacts"],
  "properties": {
    "schema_version": { "const": "kyuubiki.operator-package-distribution/v1" },
    "sdk_api_version": { "const": "kyuubiki.operator-sdk/v1" },
    "package_id": { "type": "string", "pattern": "^(?:[A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9._-]{0,126}[A-Za-z0-9])$" },
    "package_version": { "type": "string", "pattern": "^(?:[A-Za-z0-9]|[A-Za-z0-9][A-Za-z0-9._-]{0,126}[A-Za-z0-9])$" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "manifest_path",
        "manifest_sha256",
        "manifest_size_bytes",
        "entrypoint_path",
        "entrypoint_sha256",
        "entrypoint_size_bytes"
      ],
      "properties": {
        "target": { "type": "string", "pattern": "^(macos|linux|windows)-[a-z0-9_]+$" },
        "manifest_path": { "$ref": "#/$defs/relativePath" },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "manifest_size_bytes": { "type": "integer", "minimum": 1 },
        "entrypoint_path": { "$ref": "#/$defs/relativePath" },
        "entrypoint_sha256": { "$ref": "#/$defs/sha256" },
        "entrypoint_size_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
