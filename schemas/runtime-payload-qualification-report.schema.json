{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.dev/schemas/runtime-payload-qualification-report.schema.json",
  "title": "Kyuubiki Runtime Payload Qualification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "journey",
    "execution_host_role",
    "platform",
    "first_version",
    "second_version",
    "first_activation",
    "second_activation",
    "rollback_activation",
    "active_after_upgrade",
    "active_after_rollback",
    "installed_versions",
    "first_payload_sha256",
    "second_payload_sha256",
    "rollback_payload_sha256",
    "probes",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "kyuubiki.runtime-payload-qualification/v1"
    },
    "status": {
      "const": "pass"
    },
    "journey": {
      "const": "sealed-installed-runtime-payload-upgrade-and-rollback"
    },
    "execution_host_role": {
      "type": "string",
      "pattern": "^(local|remote)-(macos|linux|windows)-qualification-host$"
    },
    "platform": {
      "enum": ["macos", "linux", "windows"]
    },
    "first_version": {
      "$ref": "#/$defs/version"
    },
    "second_version": {
      "$ref": "#/$defs/version"
    },
    "first_activation": {
      "$ref": "#/$defs/activation"
    },
    "second_activation": {
      "$ref": "#/$defs/activation"
    },
    "rollback_activation": {
      "$ref": "#/$defs/activation"
    },
    "active_after_upgrade": {
      "$ref": "#/$defs/version"
    },
    "active_after_rollback": {
      "$ref": "#/$defs/version"
    },
    "installed_versions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/version"
      }
    },
    "first_payload_sha256": {
      "$ref": "#/$defs/digest"
    },
    "second_payload_sha256": {
      "$ref": "#/$defs/digest"
    },
    "rollback_payload_sha256": {
      "$ref": "#/$defs/digest"
    },
    "probes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/probe"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "allOf": [
        { "contains": { "properties": { "id": { "const": "initial_activation" } } } },
        { "contains": { "properties": { "id": { "const": "upgrade_activation" } } } },
        { "contains": { "properties": { "id": { "const": "rollback_activation" } } } },
        { "contains": { "properties": { "id": { "const": "active_after_upgrade" } } } },
        { "contains": { "properties": { "id": { "const": "active_after_rollback" } } } },
        { "contains": { "properties": { "id": { "const": "monotonic_generations" } } } },
        { "contains": { "properties": { "id": { "const": "payload_changed" } } } },
        { "contains": { "properties": { "id": { "const": "rollback_payload_restored" } } } },
        { "contains": { "properties": { "id": { "const": "all_service_entries_executed" } } } },
        { "contains": { "properties": { "id": { "const": "immutable_versions_verified" } } } },
        { "contains": { "properties": { "id": { "const": "update_lock_clean" } } } },
        { "contains": { "properties": { "id": { "const": "staging_clean" } } } }
      ],
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generation",
        "version",
        "previous_version",
        "relative_path",
        "platform"
      ],
      "properties": {
        "schema_version": {
          "const": "kyuubiki.runtime-activation/v1"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "previous_version": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/version" }
          ]
        },
        "relative_path": {
          "type": "string",
          "pattern": "^versions/[A-Za-z0-9._-]+$"
        },
        "platform": {
          "enum": ["macos", "linux", "windows"]
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "version", "service_id", "success", "job_id_observed"],
      "properties": {
        "phase": {
          "enum": ["initial-install", "upgraded-install", "rollback"]
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "service_id": {
          "enum": ["agent", "orchestrator", "frontend"]
        },
        "success": {
          "const": true
        },
        "job_id_observed": {
          "const": true
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ok"],
      "properties": {
        "id": {
          "enum": [
            "initial_activation",
            "upgrade_activation",
            "rollback_activation",
            "active_after_upgrade",
            "active_after_rollback",
            "monotonic_generations",
            "payload_changed",
            "rollback_payload_restored",
            "all_service_entries_executed",
            "immutable_versions_verified",
            "update_lock_clean",
            "staging_clean"
          ]
        },
        "ok": {
          "const": true
        }
      }
    }
  }
}
