{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.dev/schemas/kcore-export.schema.json",
  "title": "Kyuubiki Core Exchange export specification",
  "description": "Build-time input for producing a path-independent .kcore file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "core_id",
    "title",
    "kind",
    "producer",
    "artifacts",
    "contracts",
    "entrypoints"
  ],
  "properties": {
    "schema_version": { "const": "kyuubiki.kcore-export/v1" },
    "core_id": { "$ref": "kcore-manifest.schema.json#/$defs/token" },
    "title": { "$ref": "kcore-manifest.schema.json#/$defs/nonEmptyString" },
    "kind": { "$ref": "kcore-manifest.schema.json#/$defs/token" },
    "producer": { "$ref": "kcore-manifest.schema.json#/$defs/producer" },
    "created_at": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/exportArtifact" }
    },
    "contracts": {
      "type": "array",
      "items": { "$ref": "kcore-manifest.schema.json#/$defs/contract" }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "kcore-manifest.schema.json#/$defs/token" }
    },
    "provenance": {},
    "metadata": { "type": "object" }
  },
  "$defs": {
    "exportArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "media_type", "source"],
      "properties": {
        "id": { "$ref": "kcore-manifest.schema.json#/$defs/token" },
        "role": { "$ref": "kcore-manifest.schema.json#/$defs/token" },
        "media_type": { "type": "string", "minLength": 3 },
        "source": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "schema_ref": { "$ref": "kcore-manifest.schema.json#/$defs/schemaReference" },
        "encoding": { "type": "string", "minLength": 1 },
        "shape": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "unit": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" }
      }
    }
  }
}
