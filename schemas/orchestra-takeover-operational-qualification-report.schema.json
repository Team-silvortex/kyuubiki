{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kyuubiki.local/orchestra-takeover-operational-qualification-report.schema.json",
  "title": "Kyuubiki Orchestra Takeover Operational Qualification Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_unix_ms",
    "status",
    "journey",
    "topology",
    "lease_policy",
    "phases",
    "cleanup",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "kyuubiki.orchestra-takeover-operational-qualification/v1"
    },
    "generated_at_unix_ms": { "type": "integer", "minimum": 1 },
    "status": { "const": "pass" },
    "journey": { "const": "two-orchestra-postgresql-sigkill-takeover" },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orchestra_host_role",
        "database_host_role",
        "orchestra_platform",
        "database_platform",
        "database_architecture",
        "orchestra_process_count",
        "database",
        "database_ephemeral",
        "database_loopback_only",
        "transport",
        "build_profile"
      ],
      "properties": {
        "orchestra_host_role": { "const": "local-orchestra-qualification-host" },
        "database_host_role": { "const": "remote-linux-qualification-host" },
        "orchestra_platform": { "enum": ["macos", "linux"] },
        "database_platform": { "const": "linux" },
        "database_architecture": { "type": "string", "minLength": 1 },
        "orchestra_process_count": { "type": "integer", "minimum": 2 },
        "database": { "const": "postgresql" },
        "database_ephemeral": { "const": true },
        "database_loopback_only": { "const": true },
        "transport": { "const": "ssh-loopback-tunnel" },
        "build_profile": { "const": "development-no-compile" }
      }
    },
    "lease_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lease_ttl_ms", "heartbeat_ms", "retry_ms", "failure_mode"],
      "properties": {
        "lease_ttl_ms": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "heartbeat_ms": { "type": "integer", "minimum": 1 },
        "retry_ms": { "type": "integer", "minimum": 1 },
        "failure_mode": { "const": "sigkill" }
      }
    },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_owner",
        "initial_standby",
        "takeover",
        "former_owner_rejoin",
        "takeover_elapsed_ms",
        "primary_endpoint_closed"
      ],
      "properties": {
        "initial_owner": { "$ref": "#/$defs/lease_phase" },
        "initial_standby": { "$ref": "#/$defs/lease_phase" },
        "takeover": { "$ref": "#/$defs/lease_phase" },
        "former_owner_rejoin": { "$ref": "#/$defs/lease_phase" },
        "takeover_elapsed_ms": { "type": "integer", "minimum": 1, "maximum": 30000 },
        "primary_endpoint_closed": { "const": true }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orchestra_processes_stopped",
        "orchestra_ports_closed",
        "ssh_tunnel_stopped",
        "tunnel_port_closed",
        "remote_database_removed",
        "local_work_root_removed"
      ],
      "properties": {
        "orchestra_processes_stopped": { "const": true },
        "orchestra_ports_closed": { "const": true },
        "ssh_tunnel_stopped": { "const": true },
        "tunnel_port_closed": { "const": true },
        "remote_database_removed": { "const": true },
        "local_work_root_removed": { "const": true }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "const": "pass" }
        }
      }
    }
  },
  "$defs": {
    "lease_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_role",
        "lease_status",
        "observed_owner_role",
        "fencing_token"
      ],
      "properties": {
        "process_role": { "enum": ["primary", "standby", "former-owner"] },
        "lease_status": { "enum": ["owner", "standby"] },
        "observed_owner_role": { "enum": ["primary", "standby"] },
        "fencing_token": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
