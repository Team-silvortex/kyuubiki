{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.local/schemas/headless-failure-receipt.schema.json",
  "title": "Kyuubiki Headless Failure Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "error_code",
    "category",
    "stage",
    "step_index",
    "action",
    "message",
    "retryable",
    "retry_strategy",
    "recommended_action"
  ],
  "properties": {
    "schema_version": {
      "const": "kyuubiki.headless-failure-receipt/v1"
    },
    "error_code": {
      "type": "string",
      "pattern": "^kyuubiki\\.headless\\.[a-z][a-z0-9_]*$"
    },
    "category": {
      "enum": [
        "job_wait_timeout",
        "agent_queue_timeout",
        "authorization_failure",
        "model_artifact_limit_exceeded",
        "frontend_proxy_artifact_limit",
        "endpoint_not_deployed",
        "transport_failure",
        "service_request_outcome_unknown",
        "operator_task_outcome_unknown",
        "job_receipt_invalid",
        "job_result_unavailable",
        "binding_resolution",
        "result_fetch_failure",
        "job_cancelled",
        "invalid_solver_params",
        "contract_failure",
        "runtime_failure"
      ]
    },
    "stage": {
      "enum": [
        "job_wait",
        "job_observation",
        "payload_resolution",
        "batch_validation",
        "document_decode",
        "executor_preflight",
        "endpoint_configuration",
        "parameter_patch",
        "research_round",
        "material_report_validation",
        "command_validation",
        "queue",
        "authorization",
        "artifact_upload",
        "routing",
        "transport",
        "result_fetch",
        "agent_decode",
        "validation",
        "execution"
      ]
    },
    "step_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Zero is reserved for run_preflight; execution step receipts use positive indices."
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    },
    "retry_strategy": {
      "enum": ["none", "bounded_exponential_backoff"]
    },
    "recommended_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "category": {
            "enum": ["service_request_outcome_unknown", "operator_task_outcome_unknown",
              "job_receipt_invalid", "job_result_unavailable", "binding_resolution"]
          }
        }
      },
      "then": {
        "properties": {
          "retryable": { "const": false },
          "retry_strategy": { "const": "none" }
        }
      }
    },
    {
      "if": { "properties": { "step_index": { "const": 0 } } },
      "then": {
        "properties": {
          "action": { "const": "run_preflight" },
          "category": { "const": "contract_failure" },
          "retryable": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "run_preflight" } } },
      "then": { "properties": { "step_index": { "const": 0 } } }
    },
    {
      "if": {
        "properties": {
          "retryable": { "const": false }
        }
      },
      "then": {
        "properties": {
          "retry_strategy": { "const": "none" }
        }
      }
    }
  ]
}
