{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kyuubiki.operator-task-batch.schema.json",
  "title": "Kyuubiki operator task batch",
  "type": "object",
  "additionalProperties": true,
  "required": ["quality_execution_batch_contract", "operator_id", "task_count", "tasks"],
  "properties": {
    "quality_execution_batch_contract": {
      "const": "kyuubiki.quality_execution_batch/v1"
    },
    "operator_id": {
      "type": "string",
      "minLength": 1
    },
    "task_count": {
      "type": "integer",
      "minimum": 0
    },
    "agent_rpc_method": {
      "const": "run_operator_task_ir"
    },
    "batch_summary": {
      "type": "string"
    },
    "metadata": {
      "description": "Caller-owned JSON. Reserved quality fields are validated before batch preparation/execution; top-level evidence participates in the batch digest."
    },
    "case_metadata": {
      "description": "Optional shared caller-owned JSON evidence. Reserved quality fields are validated independently of per-task metadata; null does not suppress evidence in another scope."
    },
    "case_index": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case_id", "task_id", "task_digest"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "task_id": { "type": "string", "minLength": 1 },
          "task_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "description": "Runtime admission additionally requires unique nonblank case_id and actual task_ir.task_id values across entries. Whole-item JSON uniqueness is not a substitute for identity checks. Structural admission does not certify numerical validity or authenticated execution.",
      "items": {
        "type": "object",
        "required": ["case_id", "operator_id", "task_id", "task_digest", "task_ir"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "parameters": { "type": "object" },
          "metadata": {
            "description": "Caller-owned JSON retained from the candidate. Reserved quality fields must keep valid readiness, repair and enablement intent before any batch dispatch."
          },
          "operator_id": { "type": "string", "minLength": 1 },
          "task_id": { "type": "string", "minLength": 1 },
          "task_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "task_ir": {
            "$ref": "operator-task-ir.schema.json"
          },
          "agent_rpc": {
            "type": "object",
            "additionalProperties": true,
            "required": ["method", "params", "routing_opts"],
            "properties": {
              "method": { "const": "run_operator_task_ir" },
              "params": {
                "type": "object",
                "required": ["task_ir"],
                "properties": {
                  "task_ir": {
                    "$ref": "operator-task-ir.schema.json"
                  },
                  "mode": {
                    "type": "string",
                    "enum": ["preflight", "execute"]
                  }
                }
              },
              "routing_opts": {
                "description": "JSON routing hints. Producers emit an object; legacy pair arrays remain readable. Execution derives authoritative routing from the verified TaskIR.",
                "anyOf": [
                  { "type": "object" },
                  { "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 2 } }
                ]
              }
            }
          }
        }
      }
    }
  }
}
