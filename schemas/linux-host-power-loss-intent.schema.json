{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyuubiki.dev/schemas/linux-host-power-loss-intent.schema.json",
  "title": "Kyuubiki Linux Host Power-Loss Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "payload", "intent_sha256"],
  "properties": {
    "schema_version": { "const": "kyuubiki.linux-host-power-loss-intent/v1" },
    "intent_sha256": { "$ref": "#/$defs/sha256" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualification_id",
        "execution_host_role",
        "platform",
        "architecture",
        "runtime_version",
        "prepared_at_unix_ms",
        "machine_id_sha256",
        "pre_boot_id_sha256",
        "pre_uptime_seconds",
        "package",
        "activation",
        "active_entrypoint_sha256",
        "sentinel",
        "preflight"
      ],
      "properties": {
        "qualification_id": { "const": "physical-linux-host-power-loss-recovery" },
        "execution_host_role": { "const": "remote-linux-qualification-host" },
        "platform": { "const": "linux" },
        "architecture": { "type": "string", "minLength": 1 },
        "runtime_version": { "type": "string", "minLength": 1 },
        "prepared_at_unix_ms": { "type": "integer", "minimum": 1 },
        "machine_id_sha256": { "$ref": "#/$defs/sha256" },
        "pre_boot_id_sha256": { "$ref": "#/$defs/sha256" },
        "pre_uptime_seconds": { "type": "integer", "minimum": 0 },
        "package": { "type": "object" },
        "activation": { "type": "object" },
        "active_entrypoint_sha256": { "$ref": "#/$defs/sha256" },
        "sentinel": {
          "type": "object",
          "additionalProperties": false,
          "required": ["process_id", "port", "executable_sha256", "ready_before_reboot"],
          "properties": {
            "process_id": { "type": "integer", "minimum": 1 },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "executable_sha256": { "$ref": "#/$defs/sha256" },
            "ready_before_reboot": { "const": true }
          }
        },
        "preflight": { "type": "object" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
