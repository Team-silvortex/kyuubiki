#!/usr/bin/env sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
export KYUUBIKI_REPO_ROOT="$ROOT_DIR"
RUNNER="$ROOT_DIR/workers/rust/target/debug/kyuubiki-script-runner"
RUST_ROOT="$ROOT_DIR/workers/rust"

runner_is_fresh() {
  [ -x "$RUNNER" ] || return 1
  [ "$RUST_ROOT/Cargo.toml" -nt "$RUNNER" ] && return 1
  [ "$RUST_ROOT/Cargo.lock" -nt "$RUNNER" ] && return 1
  find "$RUST_ROOT/crates" -type f \( -name '*.rs' -o -name Cargo.toml \) -newer "$RUNNER" -print -quit | grep -q . && return 1
  find "$RUST_ROOT/crates" -type d -newer "$RUNNER" -print -quit | grep -q . && return 1
  return 0
}

if runner_is_fresh; then
  exec "$RUNNER" "$@"
fi

cd "$RUST_ROOT"
exec cargo run -p kyuubiki-script-runner -- "$@"
